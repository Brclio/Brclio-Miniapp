{
  "name": "brclio-miniapp",
  "version": "0.1.1",
  "private": true,
  "description": "Brclio 口袋 · 摄影与放松内容空间",
  "scripts": {
    "preview": "node scripts/preview-server.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-project.js",
    "check:release": "node scripts/check-project.js --release",
    "configure": "node scripts/configure.js",
    "build": "node scripts/build-web.js",
    "sync:firstsight": "node scripts/sync-firstsight.mjs --download",
    "dev:web": "wrangler pages dev dist/web",
    "deploy": "npm run build && wrangler pages deploy --project-name brclio-miniapp-wechat --branch main",
    "deploy:wechat-web": "npm run deploy",
    "wechat:doctor": "node scripts/wechat.js doctor",
    "wechat:open": "node scripts/wechat.js open",
    "wechat:preview": "node scripts/wechat.js preview",
    "wechat:upload": "node scripts/wechat.js upload"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "wrangler": "4.151.2"
  },
  "dependencies": {
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
