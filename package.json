{
  "name": "brclio-miniapp",
  "version": "0.1.7",
  "private": true,
  "workspaces": [
    "packages/ready-go-duel-runtime"
  ],
  "description": "Brclio 悦创 · 摄影、放松、悦学与育儿内容空间",
  "scripts": {
    "preview": "node scripts/preview-server.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-project.js",
    "check:release": "node scripts/check-project.js --release",
    "configure": "node scripts/configure.js",
    "build": "node scripts/build-native.js && node scripts/build-web.js",
    "sync:firstsight": "node scripts/sync-firstsight.mjs --download",
    "dev:web": "wrangler pages dev dist/web",
    "deploy": "npm run build && wrangler pages deploy --project-name brclio-miniapp-wechat --branch main",
    "deploy:wechat-web": "npm run deploy",
    "wechat:doctor": "node scripts/wechat.js doctor",
    "wechat:open": "node scripts/wechat.js open",
    "wechat:preview": "node scripts/wechat.js preview",
    "wechat:upload": "node scripts/wechat.js upload",
    "build:native": "node scripts/build-native.js",
    "prepare:photos": "node scripts/prepare-native-photos.js --refresh",
    "sync:lingotiles": "node scripts/sync-lingotiles.mjs",
    "adapt:lingotiles": "node scripts/build-lingotiles-web.js",
    "check:lingotiles": "node scripts/build-lingotiles-web.js && node scripts/check-lingotiles-contract.js",
    "check:nursery": "node scripts/check-nursery-covers.js && node scripts/check-nursery-music.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "tailwindcss": "3.4.17",
    "wrangler": "4.151.2"
  },
  "dependencies": {
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
