  "knownDifferences": [
    {
      "feature": "match-fusion-motion",
      "kind": "incomplete-motion-parity",
      "details": "上游按三张牌的真实来源位置聚合，并飞入固定收获区；当前原生为居中完整词卡淡入淡出。内容、锁板和计时语义已接入，但运动交互尚不等价。"
    },
    {
      "feature": "victory-celebration",
      "kind": "missing-optional-celebration",
      "details": "上游默认有约2.6秒Canvas彩纸和星星；当前原生仅静态成功标志和星级。不得以当前契约通过宣称该交互已完整迁移。"
    },
    {
      "feature": "pronunciation",
      "kind": "platform-adaptation",
      "details": "网页使用SpeechSynthesis；原生使用同域词典音频代理，需网络与微信合法域名配置。"
    },
    {
      "feature": "completion-history-and-csv",
      "kind": "platform-adaptation",
      "details": "网页IndexedDB改为原生用户目录逐次文件；原生导出通过微信文件分享。分页仍枚举和排序全部记录，大量历史的真机性能需单独验收。"
    },
    {
      "feature": "harvest-and-missing-illustration-export",
      "kind": "mobile-presentation",
      "details": "收获折叠态最新词卡为文字摘要；有图词卡在展开收获区和结果复盘中显示。"
    }
  ],
