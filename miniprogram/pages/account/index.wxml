<view class="page-shell account-shell">
  <view class="account-header">
    <view class="account-brand"><image class="account-brand-avatar" src="/assets/avatar.png" mode="aspectFill" /><view><view class="account-brand-name">Brclio / 悦创</view><view class="account-kicker">YOUR LITTLE CORNER</view></view></view>
    <button class="browse-button" bindtap="continueBrowsing" hover-class="button-pressed" aria-label="返回首页继续浏览">继续逛逛 ↗</button>
  </view>

  <view wx:if="{{user && !showBind}}" class="signed-in">
    <view class="profile-intro"><view class="eyebrow">NICE TO SEE YOU</view><view class="account-heading serif">你好，{{userLabel}}。</view><view class="account-subtitle">摄影、放松、悦学，随时回来看看。</view></view>
    <view class="profile-summary">
      <image wx:if="{{user.avatarUrl}}" class="profile-avatar" src="{{user.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="profile-initial serif" aria-hidden="true">{{userInitial}}</view>
      <view class="profile-name"><view class="profile-label">{{userLabel}}</view><view class="profile-badge">已登录</view></view>
      <button class="change-avatar" bindtap="openAvatars" disabled="{{busy || refreshing}}" hover-class="button-pressed">设置头像 ↗</button>
    </view>
    <view wx:if="{{showAvatars}}" class="avatar-picker" aria-label="头像设置">
      <view class="avatar-picker-heading"><view><view class="avatar-picker-title serif">挑一个喜欢的头像</view><view class="avatar-picker-caption">{{avatarCount}} 个小伙伴，随时换个心情。</view></view><button class="avatar-close" bindtap="closeAvatars" disabled="{{busy}}" aria-label="关闭头像设置" hover-class="button-pressed">×</button></view>
      <view class="avatar-actions"><button class="avatar-random" bindtap="randomAvatar" disabled="{{busy}}" hover-class="button-pressed">随机换一个</button><button class="avatar-upload" bindtap="uploadAvatar" disabled="{{busy}}" hover-class="button-pressed">上传我的照片 ↗</button></view>
      <view class="avatar-picker-caption avatar-upload-caption">JPG、PNG、WebP 或 GIF，最大 10 MB。保留上传原图，头像会居中裁成方形并压缩显示。</view>
      <view class="avatar-grid">
        <button wx:for="{{avatarItems}}" wx:key="id" class="avatar-option {{user.avatarId === item.id ? 'avatar-option-selected' : ''}}" data-id="{{item.id}}" bindtap="selectAvatar" disabled="{{busy}}" aria-label="{{item.label}}{{user.avatarId === item.id ? '，当前头像' : ''}}" hover-class="button-pressed"><image class="avatar-choice-image" src="{{item.url}}" mode="aspectFill" lazy-load="true" /><text class="avatar-choice-number">{{item.id}}</text></button>
      </view>
      <view class="avatar-pagination"><button bindtap="previousAvatarPage" disabled="{{busy || avatarPage === 0}}" aria-label="上一页头像" hover-class="button-pressed">← 上一页</button><text>{{avatarPage + 1}} / {{avatarPages}}</text><button bindtap="nextAvatarPage" disabled="{{busy || avatarPage + 1 >= avatarPages}}" aria-label="下一页头像" hover-class="button-pressed">下一页 →</button></view>
      <view wx:if="{{busy}}" class="avatar-save-status" role="status">正在准备并保存头像，请稍候…</view>
      <view wx:if="{{error}}" class="account-message account-error" role="alert">{{error}}</view>
    </view>
    <view class="profile-fields">
      <view class="profile-field"><text>账号</text><text selectable="true">{{user.username || '绑定邮箱后设置'}}</text></view>
      <view class="profile-field"><text>邮箱</text><text selectable="true">{{user.email || '尚未绑定'}}</text></view>
      <view class="profile-field"><text>微信</text><text>{{wechatLinked ? '已关联' : '未关联'}}</text></view>
    </view>
    <button wx:if="{{!user.email}}" class="primary-button bind-email-button" style="width: 100%; display: flex;" bindtap="startBind" hover-class="button-pressed">绑定邮箱与账号 <text aria-hidden="true">→</text></button>
    <view wx:if="{{!wechatLinked}}" class="wechat-section bind-wechat-section"><button class="wechat-button" style="width: 100%; display: flex;" bindtap="wechatLogin" loading="{{busy}}" disabled="{{busy || sendingCode || refreshing}}" hover-class="button-pressed"><view class="wechat-mark" aria-hidden="true">微</view><text>微信一键登录并绑定</text><text class="wechat-arrow" aria-hidden="true">↗</text></button><view class="wechat-caption">绑定当前账号，下次可直接用微信登录。</view></view>
    <view class="local-note"><text class="local-note-mark" aria-hidden="true">✳</text><text>保持登录，直到你主动退出。</text></view>
    <view class="sync-summary" role="status"><view class="sync-heading"><text>记录自动同步</text><text class="sync-badge">{{syncState === 'syncing' ? '同步中' : syncPending ? '待同步' : syncState === 'error' ? '稍后重试' : '已开启'}}</text></view><view class="sync-copy">{{syncMessage}}</view><view class="sync-copy">儿歌收藏、学习进度、单词收藏与最近 200 条通关足迹，以及计分挑战记录和使用偏好。断网时先存本机，联网后继续同步。</view><button class="text-button sync-retry" bindtap="retrySync" disabled="{{syncState === 'syncing'}}" hover-class="button-pressed">{{syncState === 'syncing' ? '正在同步…' : '立即同步'}}</button></view>
    <button class="text-button retry-session" bindtap="retrySession" disabled="{{busy || refreshing}}" hover-class="button-pressed">{{refreshing ? '正在更新账号状态…' : '刷新账号状态'}}</button>
    <button class="logout-button" style="width: 100%; display: block;" bindtap="logout" loading="{{busy}}" disabled="{{busy || refreshing}}" hover-class="button-pressed">退出登录</button>
  </view>

  <view wx:else class="auth-content">
    <view class="auth-intro"><view class="eyebrow">{{mode === 'bind' ? 'ONE MORE WAY TO RETURN' : 'WELCOME TO BRCLIO'}}</view><view class="account-heading serif">{{mode === 'bind' ? '为相遇，留个账号。' : mode === 'register' ? '初次见面，欢迎。' : '好久不见，欢迎回来。'}}</view><view class="account-subtitle">{{mode === 'bind' ? '绑定后，也能用邮箱或账号登录。' : '用熟悉的方式，走进自己的小角落。'}}</view></view>
    <view wx:if="{{mode !== 'bind'}}" class="auth-tabs" aria-label="登录或注册">
      <button class="auth-tab {{mode === 'login' ? 'auth-tab-active' : ''}}" data-mode="login" bindtap="switchMode" disabled="{{busy}}" hover-class="button-pressed">登录</button>
      <button class="auth-tab {{mode === 'register' ? 'auth-tab-active' : ''}}" data-mode="register" bindtap="switchMode" disabled="{{busy}}" hover-class="button-pressed">注册账号</button>
    </view>
    <view wx:if="{{mode === 'login'}}" class="login-methods" aria-label="登录方式">
      <button class="login-method {{loginMethod === 'code' ? 'login-method-active' : ''}}" data-method="code" bindtap="switchLoginMethod" disabled="{{busy}}" hover-class="button-pressed">邮箱验证码</button>
      <button class="login-method {{loginMethod === 'password' ? 'login-method-active' : ''}}" data-method="password" bindtap="switchLoginMethod" disabled="{{busy}}" hover-class="button-pressed">邮箱 / 账号密码</button>
    </view>
    <form bindsubmit="submitForm">
      <view wx:if="{{mode !== 'login' || loginMethod === 'code'}}" class="field-group"><label class="field-label" for="account-email">邮箱</label><input id="account-email" class="account-input" type="text" value="{{email}}" data-field="email" bindinput="inputField" placeholder="你的邮箱地址" maxlength="254" disabled="{{busy}}" aria-label="邮箱地址" /></view>
      <view wx:if="{{mode !== 'login'}}" class="field-group"><label class="field-label" for="account-username">账号</label><input id="account-username" class="account-input" type="text" value="{{username}}" data-field="username" bindinput="inputField" placeholder="字母开头，4–24 位字母、数字或下划线" maxlength="24" disabled="{{busy}}" aria-label="注册账号" /></view>
      <view wx:if="{{mode === 'login' && loginMethod === 'password'}}" class="field-group"><label class="field-label" for="account-identifier">邮箱 / 账号</label><input id="account-identifier" class="account-input" type="text" value="{{identifier}}" data-field="identifier" bindinput="inputField" placeholder="邮箱地址或账号" maxlength="254" disabled="{{busy}}" aria-label="邮箱地址或账号" /></view>
      <view wx:if="{{mode !== 'login' || loginMethod === 'password'}}" class="field-group"><label class="field-label" for="account-password">密码</label><input id="account-password" class="account-input" type="text" password value="{{password}}" data-field="password" bindinput="inputField" placeholder="{{mode === 'login' ? '请输入密码' : '设置 8–128 位密码'}}" maxlength="128" disabled="{{busy}}" aria-label="密码" /></view>
      <view wx:if="{{mode !== 'login'}}" class="field-group"><label class="field-label" for="account-password-confirm">确认密码</label><input id="account-password-confirm" class="account-input" type="text" password value="{{confirmPassword}}" data-field="confirmPassword" bindinput="inputField" placeholder="再次输入密码" maxlength="128" disabled="{{busy}}" aria-label="确认密码" /></view>
      <view wx:if="{{mode !== 'login' || loginMethod === 'code'}}" class="field-group"><label class="field-label" for="account-code">邮箱验证码</label><view class="code-row"><input id="account-code" class="account-input code-input" type="number" value="{{code}}" data-field="code" bindinput="inputField" placeholder="6 位验证码" maxlength="6" disabled="{{busy}}" aria-label="6 位邮箱验证码" /><button class="code-button" bindtap="sendCode" loading="{{sendingCode}}" disabled="{{busy || sendingCode || codeSeconds > 0}}" hover-class="button-pressed">{{codeSeconds > 0 ? codeSeconds + ' 秒后重发' : sendingCode ? '正在发送' : '获取验证码'}}</button></view></view>
      <view wx:if="{{error}}" class="account-message account-error" role="alert">{{error}}</view>
      <view wx:if="{{notice}}" class="account-message account-notice" role="status">{{notice}}</view>
      <checkbox-group class="consent-group" bindchange="changeConsent"><label class="consent-label"><checkbox value="agree" checked="{{agreed}}" color="#2b7fd8" disabled="{{busy}}" aria-label="同意隐私与数据说明" /><text>我已阅读并同意</text></label><button class="privacy-link" catchtap="openPrivacy" hover-class="button-pressed">《隐私与数据说明》</button></checkbox-group>
      <button class="primary-button submit-button" style="width: 100%; display: flex;" form-type="submit" loading="{{busy}}" disabled="{{busy || sendingCode || refreshing}}" hover-class="button-pressed">{{mode === 'register' ? '注册并登录' : mode === 'bind' ? '完成绑定' : '登录'}} <text aria-hidden="true">→</text></button>
    </form>
    <view wx:if="{{mode !== 'bind'}}" class="wechat-section"><view class="auth-divider"><text>也可以</text></view><button class="wechat-button" style="width: 100%; display: flex;" bindtap="wechatLogin" disabled="{{busy || sendingCode || refreshing}}" hover-class="button-pressed"><view class="wechat-mark" aria-hidden="true">微</view><text>微信一键登录 / 注册</text><text class="wechat-arrow" aria-hidden="true">↗</text></button><view class="wechat-caption">首次微信登录将自动创建账号。</view></view>
    <button wx:else class="text-button cancel-bind" bindtap="cancelBind" disabled="{{busy}}" hover-class="button-pressed">稍后绑定，返回我的账号</button>
  </view>

  <view wx:if="{{user && !showBind && !showAvatars && error}}" class="account-message account-error" role="alert">{{error}}</view>
  <view wx:if="{{user && !showBind && notice}}" class="account-message account-notice" role="status">{{notice}}</view>
  <view class="account-footer"><text>Brclio / 悦创</text><button bindtap="openPrivacy" hover-class="button-pressed">隐私与数据</button></view>
  <canvas type="2d" id="avatar-upload-canvas" class="avatar-upload-canvas" aria-hidden="true"></canvas>
</view>
