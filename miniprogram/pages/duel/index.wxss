page { width: 100%; height: 100%; overflow: hidden; background: #fefcf6; }
.duel-page { position: relative; overflow: hidden; background: #fefcf6; }
.duel-canvas { display: block; }
.duel-state { position: absolute; left: 0; top: 0; width: 100%; height: 100%; padding: 64rpx; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; background: #fefcf6; }
.state-mark { color: #2b7fd8; font-size: 70rpx; line-height: 1; }
.state-title { margin-top: 24rpx; font-size: 38rpx; font-weight: 700; }
.state-copy { margin-top: 18rpx; color: #75716a; font-size: 25rpx; line-height: 1.9; }
.state-button { margin-top: 38rpx; min-height: 44px; }
.state-back { margin-top: 12rpx; min-height: 44px; }
