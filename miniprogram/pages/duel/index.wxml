<view wx:if="{{view === 'match'}}" class="match-page" style="width:{{canvasWidth}}px;height:{{canvasHeight}}px;">
  <canvas type="2d" id="duel-canvas" class="duel-canvas" style="width:{{canvasWidth}}px;height:{{canvasHeight}}px;" disable-scroll="{{true}}" bindtouchstart="onTouchStart" catchtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchCancel" binderror="showCanvasError" aria-label="双人计分挑战游戏画布"/>
  <view wx:if="{{status === 'loading'}}" class="duel-state"><text class="state-title serif">准备一点好玩。</text><text class="state-copy">正在打开计分挑战</text></view>
  <view wx:if="{{status === 'error'}}" class="duel-state"><text class="state-title serif">先歇一下，再试试。</text><text class="state-copy">{{errorMessage}}</text><button class="primary-button" bindtap="initializeGame">重新打开</button><button class="text-button" bindtap="goHome">返回首页</button></view>
</view>

<view wx:else class="duel-mobile" style="height:{{canvasHeight}}px;">
  <view class="game-tools">
    <view class="mode-control" aria-label="游戏模式"><button class="mode-button {{gameMode === 'TOUCH' ? 'mode-selected' : ''}}" data-mode="TOUCH" bindtap="switchMode" hover-class="control-pressed" aria-label="触摸双人模式">双人对决</button><button class="mode-button {{gameMode === 'INFINITE' ? 'mode-selected' : ''}}" data-mode="INFINITE" bindtap="switchMode" hover-class="control-pressed" aria-label="无限连续对决模式">无限挑战</button></view>
    <button class="tool-button" bindtap="openSettings" hover-class="control-pressed" aria-label="游戏设置与更多玩法"><image src="/pages/duel/icons/settings.png"/></button>
    <button class="tool-button {{!soundEnabled ? 'sound-off' : ''}}" bindtap="toggleSound" hover-class="control-pressed" aria-label="{{soundEnabled ? '关闭声音' : '开启声音'}}"><image src="/pages/duel/icons/{{soundEnabled ? 'volume-2' : 'volume-x'}}.png"/></button>
  </view>

  <view class="round-heading"><view class="round-title serif">{{customTitle || '面对面，来一局。'}}</view><view class="round-caption">{{gameMode === 'INFINITE' ? '每轮都有新彩头，想玩几局都可以。' : '把手机放中间，看到 GO 再出手。'}}</view></view>

  <button wx:if="{{gameState !== 'WAITING' && gameState !== 'GO'}}" class="online-entry" bindtap="openOnline" hover-class="control-pressed" aria-label="在线 PK，各用自己的手机对战"><text>在线 PK</text><text class="online-entry-copy">各用各的手机，约个对手 →</text></button>

  <view class="play-court {{gameState === 'GO' ? 'court-go' : ''}}">
    <view wx:for="{{players}}" wx:key="id" data-player="{{item.id}}" bindtouchstart="playerTouch" hover-class="zone-pressed" class="touch-zone {{item.id}} {{item.winner ? 'zone-winner' : ''}} {{item.loser ? 'zone-loser' : ''}}" aria-role="button" aria-label="{{item.name}}的点击区域">
      <view class="zone-content {{item.id === 'p1' ? 'opposed-player' : ''}}">
        <view class="player-emblem"><image wx:if="{{item.winner}}" src="/pages/duel/icons/trophy.png"/><image wx:elif="{{item.loser && winReason === 'FALSE_START'}}" src="/pages/duel/icons/alert-triangle-rose.png"/><image wx:else src="/pages/duel/icons/hand-{{item.id === 'p1' ? 'rose' : 'sky'}}.png"/></view>
        <view class="zone-label"><view class="zone-eyebrow">{{item.id === 'p1' ? 'RED / 红方' : 'BLUE / 蓝方'}}<text wx:if="{{item.reward}}" class="has-reward"> · 彩头已就位</text></view><view class="zone-name serif">{{item.name}}</view><view class="zone-instruction"><block wx:if="{{item.winner}}">这一局，你赢了！</block><block wx:elif="{{item.loser}}">{{winReason === 'FALSE_START' ? '抢跑啦，下次等信号。' : '差一点点，再来一局。'}}</block><block wx:elif="{{gameState === 'WAITING'}}">先别动，等信号。</block><block wx:elif="{{gameState === 'GO'}}">就是现在，快点这里！</block><block wx:else>你的半边屏幕，准备好了吗？</block></view></view>
      </view>
    </view>
    <view class="status-rail status-{{gameState}}">
      <block wx:if="{{gameState === 'IDLE'}}"><text class="signal-dot"></text><text class="status-main">等你们准备好</text><text class="status-note">同屏双人</text></block>
      <block wx:elif="{{gameState === 'WAITING'}}"><text class="signal-dot"></text><text class="status-main">等一下…</text><text class="status-note">现在点会抢跑</text></block>
      <block wx:elif="{{gameState === 'GO'}}"><text class="go-word">GO!</text><text class="status-note">快！</text></block>
      <block wx:else><text class="result-name {{winner}}">{{winnerName}}胜</text><text wx:if="{{winReason === 'REACTION'}}" class="result-time">{{reactionTime}}<text class="time-unit"> ms</text></text><text wx:else class="false-result">对方抢跑犯规</text></block>
    </view>
  </view>

  <view class="game-dock">
    <block wx:if="{{gameState === 'IDLE'}}"><button class="main-action" bindtap="openRewards" hover-class="control-pressed"><text>{{gameMode === 'INFINITE' ? '开启无限挑战' : '开始对决'}}</text><text class="action-arrow">→</text></button><view class="dock-hint">可先写下彩头，也可以直接开始。</view></block>
    <block wx:elif="{{gameState === 'WAITING' || gameState === 'GO'}}"><view class="in-game-note"><text class="note-mark">{{gameState === 'GO' ? '↟' : '·'}}</text><text>{{gameState === 'GO' ? '点击各自的区域，先到的人赢。' : '保持耐心，信号会在 2～' + maxWaitTime + ' 秒出现。'}}</text></view></block>
    <block wx:else>
      <view wx:if="{{isRewardRevealed && winnerReward}}" class="reward-result"><text class="reward-result-label">这一局，赢得</text><scroll-view scroll-y class="reward-result-scroll"><text class="reward-result-content">{{winnerReward}}</text></scroll-view></view>
      <view class="result-utilities"><button wx:if="{{canRevealReward && !isRewardRevealed}}" class="utility-button reward-utility" bindtap="revealReward" hover-class="control-pressed"><image src="/pages/duel/icons/lock-yellow.png"/>揭晓彩头</button><button class="utility-button" bindtap="generateReport" disabled="{{isGeneratingReport}}" hover-class="control-pressed"><image src="/pages/duel/icons/file-image.png"/>{{isGeneratingReport ? '生成中…' : '对决战报'}}</button><button wx:if="{{gameMode === 'INFINITE'}}" class="utility-button" bindtap="showSummary" hover-class="control-pressed">本次战绩</button></view>
      <button wx:if="{{gameMode === 'INFINITE'}}" class="main-action" data-next="{{true}}" bindtap="launchRound" hover-class="control-pressed"><text>下一轮，继续！</text><text class="action-arrow">→</text></button><button wx:else class="main-action" bindtap="openRewards" hover-class="control-pressed"><text>再来一局</text><text class="action-arrow">↻</text></button>
    </block>
  </view>

  <view wx:if="{{gameState === 'ENDED'}}" class="confetti-layer"><view wx:for="{{particles}}" wx:key="id" class="confetti" style="left:{{item.left}}%;background:{{item.color}};animation-delay:{{item.delay}}s;animation-duration:{{item.duration}}s;"></view></view>

  <view wx:if="{{showSettingsModal}}" class="sheet-backdrop" style="bottom:{{keyboardHeight}}px;" catchtouchmove="noop"><view class="native-sheet settings-sheet"><view class="sheet-grip"></view><view class="sheet-header"><view><text class="sheet-kicker">MAKE IT YOURS</text><view class="sheet-title serif">这局，你来定。</view></view><button class="sheet-close" bindtap="closeSettings" aria-label="关闭游戏设置">×</button></view><scroll-view scroll-y class="sheet-scroll settings-scroll" scroll-into-view="{{formFocusId}}" scroll-with-animation>
    <view class="form-field" id="settings-title"><text class="field-label">对决名称</text><view class="native-input-row"><input adjust-position="{{false}}" cursor-spacing="16" value="{{tempSettings.title}}" data-field="title" data-focus="settings-title" bindfocus="onFormFocus" bindinput="settingsInput" placeholder="例如：今晚谁洗碗" maxlength="15"/><button class="input-action" data-field="title" bindtap="randomSetting" aria-label="随机对决名称"><image src="/pages/duel/icons/dices.png"/></button></view></view>
    <view class="name-fields"><view class="form-field" id="settings-p1"><text class="field-label red-label">红方昵称</text><view class="native-input-row"><input adjust-position="{{false}}" cursor-spacing="16" value="{{tempSettings.p1}}" data-field="p1" data-focus="settings-p1" bindfocus="onFormFocus" bindinput="settingsInput" placeholder="红方" maxlength="8"/><button class="input-action" data-field="p1" bindtap="randomSetting" aria-label="随机红方昵称"><image src="/pages/duel/icons/dices-rose.png"/></button></view></view><view class="form-field" id="settings-p2"><text class="field-label blue-label">蓝方昵称</text><view class="native-input-row"><input adjust-position="{{false}}" cursor-spacing="16" value="{{tempSettings.p2}}" data-field="p2" data-focus="settings-p2" bindfocus="onFormFocus" bindinput="settingsInput" placeholder="蓝方" maxlength="8"/><button class="input-action" data-field="p2" bindtap="randomSetting" aria-label="随机蓝方昵称"><image src="/pages/duel/icons/dices-sky.png"/></button></view></view></view>
    <view class="wait-field"><view class="field-heading"><text class="field-label">信号等待时间</text><text class="wait-value">2～{{tempSettings.maxWait}} 秒</text></view><slider min="3" max="10" step="1" value="{{tempSettings.maxWait}}" data-field="maxWait" bindchange="settingsInput" activeColor="#2b7fd8" backgroundColor="#e7e2d7" block-color="#2b7fd8" block-size="22"/><view class="slider-labels"><text>短一点</text><text>多一点悬念</text></view></view>
    <view class="settings-more"><text class="field-label">更多玩法</text><button class="settings-link" bindtap="importRewards" hover-class="control-pressed"><text>从 .txt 导入自定义彩头</text><text>↗</text></button><button class="settings-link" bindtap="openMatch" hover-class="control-pressed"><view><text>计分挑战</text><text class="link-caption">1 / 3 / 5 分 · 历史记录</text></view><text>→</text></button><button class="settings-link" bindtap="testSound" hover-class="control-pressed"><text>试听声音</text><text>♫</text></button></view><view class="sheet-footnote">昵称与彩头保留 7 天 · 本机已打开 {{visitCount}} 次</view>
  </scroll-view><view class="sheet-actions"><button class="secondary-action reset-action" bindtap="resetSettings">重置</button><button class="secondary-action" bindtap="closeSettings">取消</button><button class="main-action" bindtap="saveSettings">保存设置</button></view></view></view>

  <view wx:if="{{showRewardInput}}" class="sheet-backdrop" style="bottom:{{keyboardHeight}}px;" catchtouchmove="noop"><view class="native-sheet reward-sheet"><view class="sheet-grip"></view><view class="sheet-header"><view><text class="sheet-kicker">A LITTLE SOMETHING</text><view class="sheet-title serif">{{gameMode === 'INFINITE' ? '第一局，加点彩头。' : '赢了，想要什么？'}}</view></view><button class="sheet-close" bindtap="closeRewards" aria-label="关闭彩头设置">×</button></view><scroll-view scroll-x class="reward-categories" show-scrollbar="{{false}}"><view class="category-track"><button wx:for="{{categories}}" wx:key="key" class="category-button {{rewardCategory === item.key ? 'category-selected' : ''}}" data-category="{{item.key}}" bindtap="rewardCategory" hover-class="control-pressed">{{item.label}}</button></view></scroll-view><scroll-view scroll-y class="sheet-scroll rewards-scroll" scroll-into-view="{{formFocusId}}" scroll-with-animation>
    <view wx:for="{{players}}" wx:key="id" id="reward-{{item.id}}" class="reward-group {{item.id}}"><view class="reward-player"><text class="player-dot"></text><text>{{item.name}}赢了想要</text></view><block wx:if="{{!item.masked}}"><view class="native-input-row reward-input-row"><input adjust-position="{{false}}" cursor-spacing="16" value="{{item.reward}}" password="{{item.inputType === 'password'}}" data-player="{{item.id}}" data-focus="reward-{{item.id}}" bindfocus="onFormFocus" bindinput="rewardInput" placeholder="{{item.id === 'p1' ? '比如：免洗碗券一张' : '比如：请喝大杯奶茶'}}" maxlength="-1"/><button class="input-action" data-player="{{item.id}}" bindtap="toggleInput" aria-label="切换彩头明文密文"><image src="/pages/duel/icons/{{item.inputType === 'text' ? 'eye-off' : 'eye'}}.png"/></button></view><view class="reward-options"><button data-player="{{item.id}}" bindtap="randomReward" hover-class="control-pressed"><image src="/pages/duel/icons/dices.png"/>随机一个</button><button data-player="{{item.id}}" bindtap="lockReward" hover-class="control-pressed"><image src="/pages/duel/icons/lock.png"/>锁定彩头</button><button class="{{editingPwdPlayer === item.id ? 'option-selected' : ''}}" data-player="{{item.id}}" bindtap="editPassword" hover-class="control-pressed"><image src="/pages/duel/icons/key-round.png"/>密码</button></view><view wx:if="{{editingPwdPlayer === item.id}}" class="reward-password"><text>解锁密码</text><input adjust-position="{{false}}" cursor-spacing="16" password value="{{item.password}}" data-player="{{item.id}}" data-focus="reward-{{item.id}}" bindfocus="onFormFocus" bindinput="passwordSetting" placeholder="默认 123456" maxlength="-1"/></view></block><block wx:else><view class="locked-reward"><image src="/pages/duel/icons/lock-yellow.png"/><text>彩头已悄悄锁好</text><text class="secret-dots">••••••</text></view><view class="locked-actions"><button data-player="{{item.id}}" bindtap="requestPassword" hover-class="control-pressed">输入密码查看</button><button data-player="{{item.id}}" bindtap="clearReward" hover-class="control-pressed">清空重填</button></view></block></view>
    <view wx:if="{{viewedRewardContent}}" class="decrypted-reward"><text class="decrypted-label">已解密的彩头</text><text class="decrypted-content">{{viewedRewardContent}}</text></view><button class="import-rewards" bindtap="importRewards" hover-class="control-pressed"><image src="/pages/duel/icons/upload.png"/><text>导入自己的彩头清单</text><text class="import-format">.txt ↗</text></button><text class="sheet-footnote">不填也没关系，开始时会自动锁好已有彩头。</text>
  </scroll-view><view class="sheet-actions"><button class="main-action" bindtap="launchRound"><text>{{!p1Reward && !p2Reward && gameMode !== 'INFINITE' ? '跳过彩头，开始' : '准备好了，开始对决'}}</text><text class="action-arrow">→</text></button></view></view></view>

  <view wx:if="{{passwordVisible}}" class="sheet-backdrop password-backdrop" style="bottom:{{keyboardHeight}}px;" catchtouchmove="noop"><view class="native-sheet password-sheet"><view class="sheet-grip"></view><view class="sheet-header"><view><text class="sheet-kicker">A SECRET BETWEEN YOU</text><view class="sheet-title serif">输入解锁密码</view></view><button class="sheet-close" bindtap="closePassword" aria-label="取消输入密码">×</button></view><view id="password-check" class="password-body"><input adjust-position="{{false}}" cursor-spacing="16" password focus value="{{passwordInput}}" data-focus="password-check" bindfocus="onFormFocus" bindinput="passwordInput" placeholder="••••••" class="password-check" maxlength="-1"/></view><view class="sheet-actions"><button class="secondary-action" bindtap="closePassword">取消</button><button class="main-action" bindtap="verifyPassword">查看彩头</button></view></view></view>

  <view wx:if="{{showInfiniteSummary}}" class="sheet-backdrop" catchtouchmove="noop"><view class="native-sheet summary-sheet"><view class="sheet-grip"></view><view class="sheet-header"><view><text class="sheet-kicker">PLAY A LITTLE LONGER</text><view class="sheet-title serif">无限挑战 · 本次战绩</view></view><button class="sheet-close" bindtap="exitInfinite" aria-label="结束无限挑战">×</button></view><view class="summary-score"><view class="summary-player p1"><text>{{p1Name || '红方'}}</text><text class="summary-wins serif">{{p1Wins}}<text> 胜</text></text></view><view class="summary-divider">/</view><view class="summary-player p2"><text>{{p2Name || '蓝方'}}</text><text class="summary-wins serif">{{p2Wins}}<text> 胜</text></text></view></view><scroll-view scroll-y class="sheet-scroll summary-scroll"><view wx:for="{{infiniteStats}}" wx:key="roundNumber" class="round-row"><text class="round-number">{{item.roundNumber > 9 ? item.roundNumber : '0' + item.roundNumber}}</text><view class="round-detail"><text class="round-winner {{item.winner}}">{{item.name}}胜</text><text class="round-reward">赢得：{{item.reward}}</text></view><text class="round-mark">↗</text></view><text wx:if="{{!infiniteStats.length}}" class="empty-rounds">还没开始，来一局吧。</text></scroll-view><view class="sheet-actions"><button class="secondary-action" bindtap="exitInfinite">结束挑战</button><button class="main-action" bindtap="generateReport" disabled="{{isGeneratingReport}}">{{isGeneratingReport ? '生成中…' : '生成总战报'}}</button></view></view></view>

  <view wx:if="{{showReportModal}}" class="sheet-backdrop report-backdrop" catchtouchmove="noop"><view class="native-sheet report-sheet"><view class="sheet-grip"></view><view class="sheet-header"><view><text class="sheet-kicker">KEEP THIS MOMENT</text><view class="sheet-title serif">对决战报</view></view><button class="sheet-close" bindtap="closeReport" aria-label="关闭对决战报">×</button></view><view class="report-preview"><image class="report-image" src="{{reportImageUrl}}" mode="aspectFit" show-menu-by-longpress aria-label="本局对决战报图片"/></view><view class="sheet-actions"><button class="secondary-action" bindtap="shareReport">分享给朋友</button><button class="main-action" bindtap="saveReport">保存到相册</button></view><text class="report-note">也可以长按战报图片保存。</text></view></view>
  <canvas type="2d" id="report-canvas" class="report-canvas" style="width:600px;height:1000px;"/>
</view>
