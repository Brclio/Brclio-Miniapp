<!-- Brclio · CC BY-NC-SA 4.0. Native components; no embedded webpage. -->
<template name="wordCard">
  <view class="word-card {{item.image ? 'with-image' : ''}} lingo-view">
    <view class="word-title-row lingo-view">
      <text class="word-title lingo-text" selectable>{{item.word}}</text>
      <view class="word-actions lingo-view">
        <button class="word-action pronounce lingo-button" data-word="{{item.word}}" bindtap="speak" aria-label="朗读 {{item.word}}" hover-class="pressed"><text class="pronounce-symbol lingo-text">♪</text><text class="word-action-label lingo-text">发音</text></button>
        <button class="word-action bookmark {{item.saved ? 'is-saved' : ''}} lingo-button" data-id="{{item.id}}" bindtap="toggleSave" aria-label="{{item.saved ? '取消收藏' : '收藏'}} {{item.word}}" hover-class="pressed">{{item.saved ? '★' : '☆'}}</button>
      </view>
    </view>
    <view class="word-learning-row lingo-view">
      <view class="word-identity lingo-view">
        <text class="phonetic lingo-text" selectable>{{item.phonetic || '音标未收录'}}</text>
        <view class="word-meaning lingo-view"><text class="pos-chip lingo-text">{{item.pos}}</text><text class="lingo-text" selectable>{{item.meaning}}</text></view>
      </view>
      <image wx:if="{{item.image}}" class="word-picture" src="{{item.image}}" mode="aspectFit" lazy-load data-id="{{item.id}}" binderror="imageError" aria-label="{{item.imageAlt}}" />
    </view>
    <block wx:if="{{details}}">
      <view class="word-meta lingo-view"><text class="lingo-text">{{item.stageTitle}}</text><text class="lingo-text" wx:if="{{item.seen}}">✓ 已复习</text></view>
      <view wx:if="{{item.example}}" class="word-context lingo-view"><text class="example-en lingo-text" selectable>{{item.example}}</text><text class="example-zh lingo-text" selectable>{{item.exampleZh}}</text></view>
      <text wx:elif="{{item.definition}}" class="definition-summary lingo-text" selectable>{{item.definition}}</text>
      <block wx:if="{{item.definition && item.example}}">
        <button class="definition-toggle lingo-button" data-id="{{item.id}}" bindtap="toggleDefinition">{{item.expanded ? '收起词典释义 −' : '完整词典释义 ＋'}}</button>
        <text wx:if="{{item.expanded}}" class="definition-full lingo-text" selectable>{{item.definition}}</text>
      </block>
    </block>
  </view>
</template>

<view class="lingo-page {{phase === 'playing' ? 'in-play' : ''}} {{reduceMotion ? 'reduce-motion' : ''}} lingo-view">
  <view class="app-header lingo-view">
    <button class="brand lingo-button" data-view="game" bindtap="goView" aria-label="词了个词首页"><text class="brand-tile lingo-text">L.</text><view class="lingo-view"><text class="brand-name lingo-text">LingoTiles</text><text class="brand-subtitle lingo-text">词了个词 · 悦学</text></view></button>
    <button class="rules-button lingo-button" bindtap="showRules" aria-label="玩法说明" hover-class="pressed">?</button>
  </view>
  <view class="main-tabs lingo-view" role="tablist" aria-label="学习导航">
    <button class="main-tab {{view === 'game' ? 'selected' : ''}} lingo-button" data-view="game" bindtap="goView" role="tab" aria-selected="{{view === 'game'}}">闯关练习</button>
    <button class="main-tab {{view === 'notebook' ? 'selected' : ''}} lingo-button" data-view="notebook" bindtap="goView" role="tab" aria-selected="{{view === 'notebook'}}">单词本</button>
    <button class="main-tab {{view === 'history' ? 'selected' : ''}} lingo-button" data-view="history" bindtap="goView" role="tab" aria-selected="{{view === 'history'}}">通关足迹</button>
  </view>

  <view wx:if="{{notice}}" class="notice lingo-view" role="alert">{{notice}}</view>
  <view wx:if="{{!storageAvailable}}" class="storage-warning lingo-view">本机暂时无法保存学习进度，通关后可导出足迹备份。</view>

  <block wx:if="{{view === 'game'}}">
    <view wx:if="{{phase === 'ready'}}" class="ready-content lingo-view">
      <view class="page-heading lingo-view"><text class="eyebrow lingo-text">A LITTLE EVERY DAY</text><text class="heading serif lingo-text">玩一小局，<text class="highlight lingo-text">记住一点新世界。</text></text><view class="heading-bottom lingo-view"><text class="lingo-text">先记忆，再消除。让词汇慢慢成为你的。</text><text class="streak lingo-text">{{streak ? '连续 ' + streak + ' 天' : '每天一点进步'}}</text></view></view>

      <view class="mode-tabs lingo-view"><button class="mode-tab {{mode === 'theme' ? 'active' : ''}} lingo-button" data-mode="theme" bindtap="changeMode"><text class="lingo-text">经典主题</text><text class="mode-small lingo-text">6 个生活场景</text></button><button class="mode-tab {{mode === 'curriculum' ? 'active' : ''}} lingo-button" data-mode="curriculum" bindtap="changeMode"><text class="lingo-text">分级闯关</text><text class="mode-small lingo-text">小学 → 大学 · 10 万词</text></button></view>

      <view wx:if="{{mode === 'theme'}}" class="theme-section lingo-view">
        <view class="section-title lingo-view"><text class="lingo-text">选择今天的灵感</text><text class="section-note lingo-text">54 个精选词 · 双语例句</text></view>
        <scroll-view class="theme-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="theme-track lingo-view"><button wx:for="{{themes}}" wx:key="index" class="theme-choice {{selectedTheme === item.index ? 'active' : ''}} lingo-button" data-index="{{item.index}}" bindtap="chooseTheme" aria-label="{{item.title}}，{{item.count}} 个词，{{item.stars}}" hover-class="pressed"><text class="theme-number lingo-text">{{item.mark}}</text><text class="theme-name serif lingo-text">{{item.title}}</text><view class="theme-bottom lingo-view"><text class="lingo-text">{{item.count}} 个词</text><text class="theme-stars lingo-text">{{item.stars}}</text></view></button></view>
        </scroll-view>
      </view>

      <view wx:else class="curriculum-section lingo-view">
        <view class="section-title lingo-view"><text class="lingo-text">从基础出发，一步步进阶</text><text class="section-note lingo-text">{{totalVocabulary}} 词</text></view>
        <view class="stage-track lingo-view"><button wx:for="{{stages}}" wx:key="id" class="stage-choice {{stageId === item.id ? 'active' : ''}} lingo-button {{(courseLoading) ? 'is-disabled' : ''}}" data-id="{{item.id}}" bindtap="chooseStage" disabled="{{courseLoading}}"><text class="stage-index lingo-text">0{{item.index}}</text><text class="stage-name lingo-text">{{item.title}}</text><text class="stage-count lingo-text">{{item.count}} 词 · 每关 {{item.wordCount}} 词</text></button></view>
        <view class="course-summary lingo-view"><text class="course-name lingo-text">{{stageTitle}}</text><text class="course-description lingo-text">{{stageDescription}}</text></view>
        <view class="round-navigation lingo-view"><button class="round-step lingo-button {{(courseLoading || courseRound <= 1) ? 'is-disabled' : ''}}" data-direction="-1" bindtap="goRound" disabled="{{courseLoading || courseRound <= 1}}" aria-label="上一关">←</button><view class="round-form lingo-view"><text class="lingo-text">第</text><input class="round-input lingo-input" type="number" value="{{roundInput}}" bindinput="roundInput" bindconfirm="goRound" disabled="{{courseLoading}}" aria-label="关卡编号"/><text class="lingo-text"> / {{roundCount}} 关</text><button class="round-submit lingo-button {{(courseLoading) ? 'is-disabled' : ''}}" bindtap="goRound" disabled="{{courseLoading}}">前往</button></view><button class="round-step lingo-button {{(courseLoading || courseRound >= roundCount) ? 'is-disabled' : ''}}" data-direction="1" bindtap="goRound" disabled="{{courseLoading || courseRound >= roundCount}}" aria-label="下一关">→</button></view>
        <text class="grading-note lingo-text">分级参考考试标签与词频，仅供学习参考。大学拓展包含专业词与低频词。</text>
        <view wx:if="{{courseLoading}}" class="status-message lingo-view">正在准备本关词汇…</view>
        <view wx:if="{{courseError}}" class="error-panel lingo-view"><text class="lingo-text">{{courseError}}</text><button class="text-button lingo-button" bindtap="retryCourse">重新加载 →</button></view>
      </view>

      <view wx:if="{{level}}" class="ready-challenge lingo-view">
        <view class="challenge-top lingo-view"><view class="lingo-view"><text class="eyebrow lingo-text">{{mode === 'theme' ? 'TODAY’S LITTLE CHALLENGE' : 'YOUR NEXT STEP'}}</text><text class="challenge-name serif lingo-text">{{level.title}}</text></view><text class="challenge-count lingo-text">{{wordCount}}<text class="lingo-text">词</text></text></view>
        <text class="challenge-description lingo-text">{{level.description}}</text>
        <view class="sample-trio lingo-view" aria-label="单词、对应词性与中文含义组成一组"><view class="sample-tile tile-word lingo-view"><text class="lingo-text">bloom</text><text class="sample-label lingo-text">单词</text></view><text class="sample-plus lingo-text">＋</text><view class="sample-tile tile-pos lingo-view"><text class="lingo-text">n.</text><text class="sample-label lingo-text">词性</text></view><text class="sample-plus lingo-text">＋</text><view class="sample-tile tile-meaning lingo-view"><text class="lingo-text">花朵</text><text class="sample-label lingo-text">含义</text></view></view>
        <view class="duration-heading lingo-view"><text class="lingo-text">给记忆一点时间</text><text class="lingo-text">{{cardCount}} 张卡牌 · 三牌配对</text></view>
        <view class="duration-options lingo-view"><button wx:for="{{memoryOptions}}" wx:key="*this" class="duration-choice {{memoryDuration === item ? 'active' : ''}} lingo-button" data-seconds="{{item}}" bindtap="chooseDuration">{{item}} <text class="lingo-text">秒</text></button></view>
        <button class="primary-button begin-button lingo-button {{(courseLoading) ? 'is-disabled' : ''}}" bindtap="startMemory" disabled="{{courseLoading}}" hover-class="pressed">开始记忆 <text class="lingo-text">→</text></button>
      </view>
      <view class="learning-settings lingo-view"><view class="setting-row lingo-view"><view class="lingo-view"><text class="setting-title lingo-text">配对合成动画</text><text class="setting-description lingo-text">三张牌合成词卡，收进本关收获</text></view><switch class="lingo-switch" checked="{{matchAnimation}}" bindchange="toggleAnimation" color="#2b7fd8" aria-label="配对合成动画"/></view><view class="setting-row lingo-view"><view class="lingo-view"><text class="setting-title lingo-text">消除时朗读</text><text class="setting-description lingo-text">使用联网发音，默认关闭</text></view><switch class="lingo-switch" checked="{{sound}}" bindchange="toggleSound" color="#2b7fd8" aria-label="消除时自动朗读"/></view></view>
      <text wx:if="{{coverage}}" class="coverage-note lingo-text">词义插图已内置 {{coverage.ready}} / {{coverage.total}} 词，待补齐 {{coverage.pending}} 词。未配图的词照常学习。</text>
      <view class="study-footnote lingo-view"><text class="lingo-text">已复习 {{seenCount}} 词 · 收藏 {{savedCount}} 词</text><text class="lingo-text">每天一点积累，也会生长。</text></view>
    </view>

    <block wx:elif="{{phase === 'memory'}}">
      <view class="session-heading lingo-view"><view class="lingo-view"><text class="session-eyebrow lingo-text">{{level.title}} · 先记忆</text><text class="session-title serif lingo-text">让单词在脑海里碰个面。</text></view><button class="quiet-button lingo-button" bindtap="backToSelection">选关</button></view>
      <view class="memory-note lingo-view"><text class="lingo-text">共 {{wordCount}} 个单词，试着把英文、词性和含义一起读出来。</text><text class="lingo-text">倒计时结束后自动进入消除。</text></view>
      <view wx:if="{{paused}}" class="paused-panel lingo-view"><text class="pause-symbol lingo-text">Ⅱ</text><text class="serif lingo-text">给记忆一点呼吸。</text><text class="muted lingo-text">词表已收起，计时暂停。</text><button class="primary-button lingo-button" bindtap="togglePause">继续记忆 →</button></view>
      <view wx:else class="memory-list lingo-view"><template wx:for="{{memoryWords}}" wx:key="id" is="wordCard" data="{{item:item, details:false}}"/></view>
      <view class="memory-dock lingo-view"><view class="memory-clock lingo-view"><text class="lingo-text">记忆倒计时</text><text class="timer {{remaining <= 10 ? 'urgent' : ''}} lingo-text">{{remainingText}}</text></view><button class="pause-control lingo-button" bindtap="togglePause" aria-label="{{paused ? '继续记忆' : '暂停记忆'}}">{{paused ? '继续' : '暂停'}}</button><button class="primary-button memory-start lingo-button {{(paused) ? 'is-disabled' : ''}}" bindtap="startPlaying" disabled="{{paused}}">记住了，开始 →</button></view>
    </block>

    <block wx:elif="{{phase === 'playing'}}">
      <view class="play-heading lingo-view"><view class="lingo-view"><text class="session-eyebrow lingo-text">{{level.title}}</text><text class="play-title serif lingo-text">让刚刚记住的，连在一起。</text></view><button class="quiet-button lingo-button" bindtap="backToSelection">选关</button></view>
      <view class="game-metrics lingo-view"><view class="lingo-view"><text class="metric-label lingo-text">已配对</text><text class="metric-value lingo-text">{{matchCount}}<text class="lingo-text"> / {{wordCount}}</text></text></view><view class="lingo-view"><text class="metric-label lingo-text">消除用时</text><text class="metric-value timer lingo-text">{{elapsedText}}</text></view><view class="lingo-view"><text class="metric-label lingo-text">本局得分</text><text class="metric-value lingo-text">{{score}}</text></view><button class="pause-game lingo-button" bindtap="togglePause" aria-label="{{paused ? '继续游戏' : '暂停游戏'}}">{{paused ? '▶' : 'Ⅱ'}}</button></view>
      <view wx:if="{{paused}}" class="paused-panel game-pause lingo-view"><text class="pause-symbol lingo-text">Ⅱ</text><text class="serif lingo-text">休息一下，记忆也需要呼吸。</text><text class="muted lingo-text">棋盘已收起，消除计时暂停。</text><button class="primary-button lingo-button" bindtap="togglePause">继续游戏 →</button></view>
      <view wx:else class="board-section lingo-view">
        <view class="board-legend lingo-view"><text class="lingo-text"><text class="legend-dot word-dot lingo-text"></text>单词</text><text class="lingo-text"><text class="legend-dot pos-dot lingo-text"></text>词性</text><text class="lingo-text"><text class="legend-dot meaning-dot lingo-text"></text>含义</text><text class="board-instruction lingo-text">上层的牌先选</text></view>
        <view class="tile-board lingo-view" style="{{boardStyle}}" aria-busy="{{!!fusionWord}}">
          <button wx:for="{{tiles}}" wx:key="id" class="board-tile tile-{{item.kind}} {{item.available ? '' : 'is-covered'}} {{item.hinted ? 'hinted' : ''}} lingo-button {{(!item.available || !!fusionWord) ? 'is-disabled' : ''}}" style="{{item.style}}" disabled="{{!item.available || !!fusionWord}}" data-id="{{item.id}}" bindtap="pickTile" aria-label="{{item.ariaLabel}}" hover-class="tile-pressed"><text class="tile-copy {{item.long ? 'long-copy' : ''}} lingo-text">{{item.text}}</text><text class="tile-kind lingo-text">{{item.kindLabel}}</text></button>
          <view wx:if="{{fusionWord}}" class="fusion-card {{reduceMotion ? 'static-fusion' : ''}} lingo-view" style="animation-duration:{{fusionDuration}}ms;" role="status"><text class="fusion-caption lingo-text">三张牌，一个新记忆</text><image wx:if="{{fusionWord.image}}" src="{{fusionWord.image}}" class="fusion-image" mode="aspectFit" data-id="{{fusionWord.id}}" binderror="imageError"/><text class="fusion-english lingo-text">{{fusionWord.word}}</text><text class="fusion-meaning lingo-text">{{fusionWord.pos}}　{{fusionWord.meaning}}</text><text class="fusion-footnote lingo-text">已收进本关收获 ✓</text></view>
        </view>
        <text class="board-caption lingo-text">选出「单词 ＋ 对应词性 ＋ 中文含义」，顺序不限。</text>
      </view>
      <view class="play-settings lingo-view"><label class="lingo-label"><text class="lingo-text">合成动画</text><switch class="lingo-switch" checked="{{matchAnimation}}" bindchange="toggleAnimation" color="#2b7fd8" aria-label="配对合成动画"/></label><label class="lingo-label"><text class="lingo-text">消除朗读</text><switch class="lingo-switch" checked="{{sound}}" bindchange="toggleSound" color="#2b7fd8" aria-label="消除时朗读"/></label><button class="quiet-button lingo-button" bindtap="restart">重新记忆</button></view>

      <view class="game-dock lingo-view"><view class="tray-heading {{trayCount >= 5 ? 'danger' : ''}} lingo-view"><text class="lingo-text">{{trayCount >= 5 ? '快满了，优先完成已有配对' : '暂存槽 · 凑齐一组自动消除'}}</text><text class="lingo-text">{{trayCount}} / 7</text></view><view class="tray lingo-view"><view wx:for="{{tray}}" wx:key="index" class="tray-slot lingo-view"><view wx:if="{{!item.empty}}" class="tray-tile tile-{{item.kind}} lingo-view" aria-label="{{item.kindLabel}}：{{item.text}}"><text class="tray-copy lingo-text">{{item.text}}</text><text class="tray-kind lingo-text">{{item.kindLabel}}</text></view><text wx:else class="slot-number lingo-text">{{index + 1}}</text></view></view><text wx:if="{{trayReadout}}" class="tray-readout lingo-text">{{trayReadout}}</text><view class="tool-row lingo-view"><button class="lingo-button {{(!canUndo || paused || !!fusionWord) ? 'is-disabled' : ''}}" data-tool="undo" bindtap="useTool" disabled="{{!canUndo || paused || !!fusionWord}}"><text class="tool-symbol lingo-text">↶</text> 撤回 <text class="tool-count lingo-text">{{toolsLeft.undo}}</text></button><button class="lingo-button {{(!toolsLeft.hint || paused || !!fusionWord) ? 'is-disabled' : ''}}" data-tool="hint" bindtap="useTool" disabled="{{!toolsLeft.hint || paused || !!fusionWord}}"><text class="tool-symbol lingo-text">✦</text> 提示 <text class="tool-count lingo-text">{{toolsLeft.hint}}</text></button><button class="lingo-button {{(!toolsLeft.shuffle || paused || !!fusionWord) ? 'is-disabled' : ''}}" data-tool="shuffle" bindtap="useTool" disabled="{{!toolsLeft.shuffle || paused || !!fusionWord}}"><text class="tool-symbol lingo-text">⇄</text> 洗牌 <text class="tool-count lingo-text">{{toolsLeft.shuffle}}</text></button></view></view>
    </block>

    <view wx:elif="{{phase === 'result'}}" class="result-content lingo-view">
      <view class="result-banner {{won ? 'success' : 'retry'}} lingo-view"><text class="result-mark lingo-text">{{won ? '✓' : '↗'}}</text><text class="eyebrow lingo-text">{{won ? 'A LITTLE MORE IS YOURS' : 'ONE MORE LITTLE TRY'}}</text><text class="result-heading serif lingo-text">{{won ? '你又收获了一小片新世界。' : '差一点点，再给记忆一次机会。'}}</text><text class="result-copy lingo-text">{{won ? '完成 ' + wordCount + ' 组配对，每一点努力都有回响。' : '这一局已配对 ' + matchCount + ' / ' + wordCount + ' 个单词，慢慢来。'}}</text><text wx:if="{{won}}" class="result-stars lingo-text">{{starsText}}</text></view>
      <view class="result-facts lingo-view"><view class="lingo-view"><text class="lingo-text">消除用时</text><text class="result-number lingo-text">{{elapsedText}}</text></view><view class="lingo-view"><text class="lingo-text">记忆用时</text><text class="result-number lingo-text">{{studyText}}</text></view><view class="lingo-view"><text class="lingo-text">合计用时</text><text class="result-number lingo-text">{{totalText}}</text></view></view>
      <view class="result-score lingo-view"><text class="lingo-text">本局 {{score}} 分</text><text class="lingo-text">星级由道具次数决定，速度只用于记录</text></view>
      <text wx:if="{{historySaveState}}" class="save-state lingo-text">{{historySaveState}}</text>
      <view class="result-actions lingo-view"><button wx:if="{{won}}" class="primary-button lingo-button" bindtap="nextChallenge">前往下一关 →</button><button wx:else class="primary-button lingo-button" bindtap="startMemory">重新记忆 →</button><button wx:if="{{!won && canUndo}}" class="secondary-button lingo-button" data-tool="undo" bindtap="useTool">撤回并继续 · 剩余 {{toolsLeft.undo}} 次</button><button wx:if="{{won}}" class="secondary-button lingo-button" bindtap="startMemory">再练一次</button><button class="quiet-button lingo-button" bindtap="backToSelection">返回选关</button></view>
      <view wx:if="{{harvestWords.length}}" class="result-review lingo-view"><view class="section-title lingo-view"><text class="lingo-text">再看一眼，就更熟悉</text><text class="section-note lingo-text">本局已配对的词</text></view><template wx:for="{{harvestWords}}" wx:key="id" is="wordCard" data="{{item:item, details:false}}"/></view>
    </view>

    <view wx:if="{{matchAnimation && (phase === 'playing' || phase === 'result')}}" class="harvest-section lingo-view"><view class="harvest-heading lingo-view"><text class="lingo-text">本关收获 <text class="harvest-count lingo-text">{{harvestCount}} / {{wordCount}}</text></text><button class="quiet-button lingo-button {{(!harvestCount) ? 'is-disabled' : ''}}" bindtap="toggleHarvest" disabled="{{!harvestCount}}">{{harvestExpanded ? '收起 −' : '查看词卡 ＋'}}</button></view><view class="lingo-view" wx:if="{{harvestExpanded}}"><view class="harvest-note lingo-view"><text class="lingo-text">已收好的词卡随时可以回看。</text><button wx:if="{{pendingIllustrations}}" class="text-button lingo-button {{(exporting) ? 'is-disabled' : ''}}" bindtap="exportMissing" disabled="{{exporting}}">导出待配图词单 · {{pendingIllustrations}} 词</button></view><template wx:for="{{harvestWords}}" wx:key="id" is="wordCard" data="{{item:item, details:false}}"/></view><view wx:elif="{{latestHarvest}}" class="harvest-latest lingo-view"><text class="harvest-latest-word lingo-text">{{latestHarvest.word}}</text><text class="lingo-text">{{latestHarvest.pos}}　{{latestHarvest.meaning}}</text><text class="harvest-check lingo-text">✓</text></view><text wx:else class="harvest-empty lingo-text">下一组配对，会成为一张完整词卡。</text></view>
  </block>

  <view wx:elif="{{view === 'notebook'}}" class="notebook-content lingo-view">
    <view class="page-heading lingo-view"><text class="eyebrow lingo-text">YOUR WORD COLLECTION</text><text class="heading serif lingo-text">十万个词，<text class="highlight lingo-text">一点点成为你的。</text></text><text class="heading-note lingo-text">搜索中英文，把还想再记一次的词收进收藏。</text></view>
    <view class="notebook-filters lingo-view"><button class="{{notebookFilter === 'all' ? 'active' : ''}} lingo-button" data-filter="all" bindtap="notebookFilter">全部 {{totalVocabulary}}</button><button class="{{notebookFilter === 'seen' ? 'active' : ''}} lingo-button" data-filter="seen" bindtap="notebookFilter">已复习 {{seenCount}}</button><button class="{{notebookFilter === 'saved' ? 'active' : ''}} lingo-button" data-filter="saved" bindtap="notebookFilter">收藏 {{savedCount}}</button></view>
    <view class="search-row lingo-view"><view class="search-input-wrap lingo-view"><text class="lingo-text">⌕</text><input class="lingo-input" type="text" placeholder="搜索英文或中文含义" value="{{notebookQuery}}" bindinput="notebookSearch" bindconfirm="searchNow" confirm-type="search" aria-label="搜索英文或中文含义"/></view><picker range="{{stageOptions}}" value="{{notebookStage}}" bindchange="notebookStage" aria-label="按学习阶段筛选"><view class="stage-picker lingo-view">{{stageOptions[notebookStage]}}⌄</view></picker></view>
    <view class="list-status lingo-view"><text class="lingo-text">{{notebookLoading ? '正在读取词库… ' + notebookScan + '%' : '共 ' + notebookTotal + ' 个词条 · 每页 18 词'}}</text><text class="lingo-text">联网发音 ♪</text></view>
    <view wx:if="{{notebookError}}" class="error-panel lingo-view"><text class="lingo-text">{{notebookError}}</text><button class="text-button lingo-button" bindtap="loadNotebook">重新加载 →</button></view>
    <view wx:elif="{{!notebookLoading && !notebookTotal}}" class="empty-state lingo-view"><text class="empty-mark lingo-text">☆</text><text class="serif lingo-text">{{notebookQuery ? '还没找到这个词' : notebookFilter === 'saved' ? '把容易忘的词，留在这里。' : '单词旅程，正要开始。'}}</text><text class="lingo-text">{{notebookQuery ? '试试英文拼写或更短的中文关键词。' : notebookFilter === 'saved' ? '点击词卡上的星标，就能加入收藏。' : '完成记忆阶段后，单词会自动出现在这里。'}}</text></view>
    <view wx:else class="notebook-list {{notebookLoading ? 'is-loading' : ''}} lingo-view" aria-busy="{{notebookLoading}}"><template wx:for="{{notebookWords}}" wx:key="id" is="wordCard" data="{{item:item, details:true}}"/></view>
    <view class="pagination lingo-view"><button class="lingo-button {{(notebookPage <= 0 || notebookLoading) ? 'is-disabled' : ''}}" data-direction="-1" bindtap="notebookPage" disabled="{{notebookPage <= 0 || notebookLoading}}">← 上一页</button><text class="lingo-text">{{notebookPageNumber}} / {{notebookPages}}</text><button class="lingo-button {{(notebookPage + 1 >= notebookPages || notebookLoading) ? 'is-disabled' : ''}}" data-direction="1" bindtap="notebookPage" disabled="{{notebookPage + 1 >= notebookPages || notebookLoading}}">下一页 →</button></view>
    <text class="source-note lingo-text">词库来源 ECDICT · MIT，经去重与词性义项整理。分级仅作学习参考；原六主题保留双语例句。词典释义可能包含多义或历史用法。图片按当前页读取，文字可先学习。</text>
  </view>

  <view wx:elif="{{view === 'history'}}" class="history-content lingo-view">
    <view class="page-heading lingo-view"><text class="eyebrow lingo-text">MY LEARNING JOURNEY</text><text class="heading serif lingo-text">每一次通关，<text class="highlight lingo-text">都有迹可循。</text></text><text class="heading-note lingo-text">记下认真记忆的时间，也记下越玩越熟悉的自己。</text></view>
    <view class="history-summary lingo-view"><view class="history-total lingo-view"><text class="lingo-text">完整通关记录</text><text class="history-big lingo-text">{{historyTotal}}<text class="lingo-text">次</text></text><text class="lingo-text">重玩同一关也单独记录</text></view><view class="history-times lingo-view"><view class="lingo-view"><text class="lingo-text">最近消除</text><text class="lingo-text">{{historyLatest}}</text></view><view class="lingo-view"><text class="lingo-text">最快消除</text><text class="lingo-text">{{historyFastest}}</text></view></view></view>
    <view class="history-toolbar lingo-view"><text class="lingo-text">按完成时间倒序</text><button class="export-button lingo-button {{(exporting || !historyTotal) ? 'is-disabled' : ''}}" bindtap="exportHistory" disabled="{{exporting || !historyTotal}}">{{exporting ? '正在导出…' : '导出全部 CSV ↗'}}</button></view>
    <text wx:if="{{!historyPersisted}}" class="storage-warning lingo-text">部分足迹仅临时保存在本页，请导出 CSV 备份。</text><text wx:if="{{legacySessions}}" class="source-note lingo-text">另有 {{legacySessions}} 次旧通关只保留汇总成绩，无法还原逐局用时。</text>
    <view wx:if="{{historyError}}" class="error-panel lingo-view"><text class="lingo-text">{{historyError}}</text><button class="text-button lingo-button" bindtap="loadHistory">重新读取 →</button></view>
    <text wx:if="{{historyLoading}}" class="status-message lingo-text">正在读取通关足迹…</text>
    <view wx:elif="{{!historyTotal}}" class="empty-state lingo-view"><text class="empty-mark lingo-text">↗</text><text class="serif lingo-text">第一条足迹，从下一关开始。</text><text class="lingo-text">成功通关后，记忆、消除用时和成绩会出现在这里。</text><button class="primary-button lingo-button" data-view="game" bindtap="goView">开始一次挑战 →</button></view>
    <view wx:else class="history-list lingo-view"><view wx:for="{{historyRecords}}" wx:key="id" class="history-record lingo-view"><view class="record-top lingo-view"><text class="record-mode lingo-text">{{item.modeLabel}}</text><text class="record-stars lingo-text">{{item.starsLabel}}</text></view><text class="record-title serif lingo-text">{{item.levelTitle}}</text><text class="record-date lingo-text">{{item.dateLabel}} · 北京时间</text><view class="record-metrics lingo-view"><view class="lingo-view"><text class="lingo-text">消除</text><text class="record-game-time lingo-text">{{item.gameTime}}</text></view><view class="lingo-view"><text class="lingo-text">记忆</text><text class="lingo-text">{{item.studyTime}}</text></view><view class="lingo-view"><text class="lingo-text">总用时</text><text class="lingo-text">{{item.totalTime}}</text></view><view class="lingo-view"><text class="lingo-text">得分</text><text class="lingo-text">{{item.score}}</text></view></view><view class="record-bottom lingo-view"><text class="lingo-text">{{item.wordCount}} 个单词</text><text class="lingo-text">使用道具 {{item.assists}} 次</text></view></view></view>
    <view wx:if="{{historyTotal}}" class="pagination lingo-view"><button class="lingo-button {{(historyPage <= 1 || historyLoading) ? 'is-disabled' : ''}}" data-direction="-1" bindtap="historyPage" disabled="{{historyPage <= 1 || historyLoading}}">← 上一页</button><text class="lingo-text">{{historyPage}} / {{historyPages}}</text><button class="lingo-button {{(historyPage >= historyPages || historyLoading) ? 'is-disabled' : ''}}" data-direction="1" bindtap="historyPage" disabled="{{historyPage >= historyPages || historyLoading}}">下一页 →</button></view>
    <text class="source-note lingo-text">记录保存在这台设备。清除小程序数据会移除记录，可导出 CSV 留存。用时不包含暂停、说明弹层和合成展示；不同关卡词数和难度不同，用时仅作学习参考。</text>
  </view>

  <view wx:if="{{phase !== 'playing' && phase !== 'memory'}}" class="app-credit lingo-view"><text class="lingo-text">Brclio 悦创</text><text class="lingo-text">MAKE LITTLE THINGS COUNT.</text></view>

  <view wx:if="{{rulesOpen}}" class="dialog-backdrop lingo-view" bindtap="closeRules" catchtouchmove="noop"><view class="rules-sheet lingo-view" catchtap="noop"><view class="rules-sheet-header lingo-view"><view class="lingo-view"><text class="eyebrow lingo-text">HOW TO PLAY</text><text class="rules-title serif lingo-text">先记忆，再让它们重逢。</text></view><button class="close-button lingo-button" bindtap="closeRules" aria-label="关闭玩法说明">×</button></view><scroll-view scroll-y class="rules-scroll"><view class="rule-step lingo-view"><text class="rule-number lingo-text">01</text><view class="lingo-view"><text class="rule-name lingo-text">给记忆一点时间</text><text class="lingo-text">开始后先阅读本关全部单词、词性和中文含义。可提前进入消除，也可等待倒计时结束。</text></view></view><view class="rule-step lingo-view"><text class="rule-number lingo-text">02</text><view class="lingo-view"><text class="rule-name lingo-text">三张牌，一个新记忆</text><text class="lingo-text">选择英文、对应词性、中文含义各一张，自动组成一组。只能选择没有被上层遮住的牌。相同的词性和完全相同的中文含义卡牌可以通用。</text></view></view><view class="rule-step lingo-view"><text class="rule-number lingo-text">03</text><view class="lingo-view"><text class="rule-name lingo-text">留意七个暂存槽</text><text class="lingo-text">槽位满且没有组成配对，本局结束。撤回 3 次、提示 2 次、洗牌 2 次；撤回不会拆散已完成的配对。失败后有剩余撤回机会时可继续。</text></view></view><view class="rules-detail lingo-view"><text class="lingo-text">不使用道具获得 3 星；使用 1–2 次获得 2 星；更多获得 1 星。每配对一个词得 100 分，每次道具扣 30 分，最低 0 分。</text><text class="lingo-text">消除阶段没有时间限制。暂停、此说明弹层和合成展示不计入用时；切到后台仍按实际时间结算。</text><text class="lingo-text">合成动画默认关闭。开启后，三张牌会合成完整词卡，收进本关收获。展示时棋盘和道具暂时锁定，可随时关闭动画或暂停。</text><text class="lingo-text">发音需要联网。微信音频或网络暂不可用时，会明确提示，可继续参考音标。单词本支持英文、中文搜索、收藏和分级浏览。</text><text class="lingo-text">学习进度与通关足迹保存在本机，无需账号。每次成功通关均新增足迹，可导出 CSV 备份。</text></view><view class="setting-row motion-setting lingo-view"><view class="lingo-view"><text class="setting-title lingo-text">减少动态效果</text><text class="setting-description lingo-text">合成词卡使用静态展示</text></view><switch class="lingo-switch" checked="{{reduceMotion}}" bindchange="toggleReducedMotion" color="#2b7fd8" aria-label="减少动态效果"/></view><text class="source-note lingo-text">LingoTiles 词了个词 · Brclio 设计适配。ECDICT 词库遵循 MIT 许可。</text></scroll-view><button class="primary-button rules-done lingo-button" bindtap="closeRules">知道了，继续 →</button></view></view>
</view>
