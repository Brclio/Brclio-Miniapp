/* Native adaptation of Brclio Design System's app header, tabs and editorial cards. */
.home-shell { padding-top: 12rpx; }
.portal-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 112rpx; }
.brand-lockup { display: flex; align-items: center; gap: 16rpx; min-width: 0; }
.brand-avatar { width: 68rpx; height: 68rpx; border-radius: 50%; flex-shrink: 0; }
.brand-title { font-size: 28rpx; font-weight: 700; letter-spacing: 1rpx; }
.brand-slash { color: #2b7fd8; margin: 0 5rpx; font-weight: 400; }
.brand-caption { font-size: 20rpx; color: #75716a; margin-top: 2rpx; }
.header-button { min-height: 44px; min-width: 44px; padding: 20rpx 0 20rpx 20rpx; background: transparent; font-size: 23rpx; color: #4a4a5a; display: flex; align-items: center; justify-content: flex-end; gap: 8rpx; flex-shrink: 0; }
.category-nav { position: sticky; top: 0; z-index: 10; display: flex; background: #fefcf6; border-bottom: 1rpx solid #dedbd2; margin-top: 14rpx; }
.category-tab { flex: 1; min-width: 0; min-height: 58px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rpx; padding: 15rpx 4rpx; background: transparent; color: #817d76; font-size: 26rpx; border-bottom: 4rpx solid transparent; margin-bottom: -1rpx; }
.category-tab-active { color: #2b7fd8; border-bottom-color: #2b7fd8; font-weight: 700; }
.tab-english { font-size: 14rpx; letter-spacing: 1rpx; font-weight: 500; }
.section-intro { padding: 42rpx 0 32rpx; }
.intro-topline { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.intro-topline .eyebrow { font-size: 17rpx; letter-spacing: 2rpx; }
.issue-number { font-size: 18rpx; color: #817d76; }
.intro-title { margin-top: 22rpx; font-size: 48rpx; line-height: 1.55; font-weight: 700; letter-spacing: -1rpx; }
.word-highlight { background: linear-gradient(transparent 68%, rgba(244, 215, 88, 0.7) 68%, rgba(244, 215, 88, 0.7) 93%, transparent 93%); }
.intro-copy { margin-top: 12rpx; font-size: 23rpx; color: #75716a; line-height: 1.8; }
.photo-feature { width: 100%; display: block; padding: 0; text-align: left; background: transparent; }
.photo-cover { position: relative; height: 570rpx; overflow: hidden; background: #e7e0d4; border-radius: 8rpx; }
.cover-image { width: 100%; height: 100%; display: block; }
.cover-caption { position: absolute; top: 26rpx; left: 26rpx; right: 26rpx; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; color: #fefcf6; font-size: 18rpx; letter-spacing: 2rpx; text-shadow: 0 1rpx 6rpx rgba(26, 26, 46, 0.5); }
.cover-open { position: absolute; right: 26rpx; bottom: 26rpx; width: 74rpx; height: 74rpx; border-radius: 50%; background: #fefcf6; color: #2b7fd8; display: flex; align-items: center; justify-content: center; font-size: 37rpx; }
.photo-details { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 24rpx 0 29rpx; border-bottom: 1rpx solid #dedbd2; }
.feature-title { font-size: 32rpx; font-weight: 700; line-height: 1.45; }
.feature-subtitle { font-size: 21rpx; color: #817d76; margin-top: 5rpx; }
.photo-action { color: #2b7fd8; font-size: 23rpx; flex-shrink: 0; display: flex; align-items: center; gap: 12rpx; }
.photo-action text { font-size: 31rpx; }
.inspiration-entry { width: 100%; padding: 28rpx 0; display: flex; align-items: center; gap: 22rpx; background: transparent; text-align: left; border-bottom: 1rpx solid #dedbd2; }
.inspiration-mark { width: 114rpx; height: 132rpx; background: #f5e9b0; flex-shrink: 0; display: flex; align-items: center; justify-content: center; flex-direction: column; color: #847031; font-family: 'Songti SC', 'STSong', serif; font-size: 50rpx; line-height: 1.2; border-radius: 2rpx; transform: rotate(-3deg); }
.mark-small { font-family: -apple-system, 'PingFang SC', sans-serif; font-size: 10rpx; letter-spacing: 1rpx; margin-top: 11rpx; }
.entry-body { flex: 1; min-width: 0; }
.entry-topline { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; flex-wrap: wrap; }
.entry-title { font-size: 27rpx; font-weight: 700; }
.ai-badge { font-size: 17rpx; color: #8c4439; background: #fae9e2; padding: 2rpx 10rpx; border-radius: 4rpx; white-space: nowrap; }
.entry-copy { font-size: 22rpx; color: #75716a; line-height: 1.85; margin-top: 8rpx; }
.entry-arrow { color: #2b7fd8; font-size: 31rpx; flex-shrink: 0; }
.editorial-note { display: flex; align-items: center; gap: 19rpx; padding: 32rpx 0 40rpx; font-size: 22rpx; color: #817d76; }
.note-symbol { font-size: 42rpx; color: #2b7fd8; }
.note-emphasis { color: #4a4a5a; }
.feature-pressed { opacity: 0.85; }
.duel-entry { width: 100%; display: block; padding: 0; background: transparent; text-align: left; }
.duel-visual { padding: 28rpx 26rpx 24rpx; background: #f4efd9; border-radius: 8rpx; }
.duel-visual-top { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.game-label { color: #2b7fd8; font-size: 19rpx; letter-spacing: 2rpx; font-weight: 700; }
.game-edition { color: #8b805c; font-size: 16rpx; letter-spacing: 1rpx; }
.duel-court { display: flex; align-items: center; justify-content: center; padding: 46rpx 0 38rpx; }
.duel-player { width: 216rpx; height: 216rpx; display: flex; align-items: center; justify-content: center; flex-direction: column; border-radius: 50%; font-size: 75rpx; font-family: 'Songti SC', 'STSong', serif; font-weight: 700; line-height: 1.1; }
.player-one { color: #fefcf6; background: #2b7fd8; transform: rotate(-8deg); }
.player-two { color: #1a1a2e; background: #f4d758; transform: rotate(8deg); }
.player-caption { font-family: -apple-system, 'PingFang SC', sans-serif; font-size: 19rpx; font-weight: 400; margin-top: 15rpx; }
.duel-versus { padding: 0 15rpx; font-size: 36rpx; font-style: italic; color: #817550; }
.duel-bottom { display: flex; align-items: center; justify-content: center; gap: 11rpx; font-size: 20rpx; color: #827759; }
.duel-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #e84a5f; }
.game-details { padding: 27rpx 0 0; }
.small-label { font-size: 19rpx; color: #2b7fd8; letter-spacing: 1rpx; }
.game-copy { font-size: 23rpx; color: #75716a; margin-top: 12rpx; }
.game-tags { display: flex; flex-wrap: wrap; gap: 12rpx 24rpx; margin-top: 20rpx; font-size: 20rpx; color: #817d76; }
.game-action { display: flex; align-items: center; justify-content: space-between; margin-top: 28rpx; min-height: 96rpx; padding: 18rpx 30rpx; border-radius: 8rpx; background: #2b7fd8; color: #fefcf6; font-size: 27rpx; font-weight: 600; }
.game-action text:last-child { font-size: 35rpx; font-weight: 400; }
.play-note { margin: 36rpx 0 42rpx; padding-top: 26rpx; border-top: 1rpx solid #dedbd2; }
.play-note-title { font-size: 29rpx; margin-top: 8rpx; font-weight: 600; }
.learning-entry { padding: 0; background: transparent; text-align: left; }
.learning-poster { padding: 28rpx; border-radius: 8rpx; background: #eaf1f6; overflow: hidden; }
.learning-poster-top { display: flex; align-items: center; justify-content: space-between; font-size: 17rpx; letter-spacing: 2rpx; color: #526d85; }
.learning-poster-title { margin-top: 30rpx; font-size: 68rpx; line-height: 1.2; color: #2b7fd8; font-weight: 700; }
.learning-poster-title text { margin-left: 12rpx; color: #262b30; }
.learning-tile-row { display: flex; gap: 16rpx; justify-content: center; margin: 35rpx 0 34rpx; }
.learning-tile { display: flex; align-items: center; justify-content: center; width: 170rpx; min-height: 135rpx; border-radius: 9rpx; border-bottom: 6rpx solid rgba(26,26,46,0.12); font-size: 34rpx; }
.learning-tile-word { color: #fefcf6; background: #2b7fd8; font-family: 'Songti SC', 'STSong', serif; transform: rotate(-6deg); }
.learning-tile-pos { color: #665521; background: #f4d758; font-family: 'Songti SC', 'STSong', serif; transform: translateY(12rpx) rotate(3deg); }
.learning-tile-meaning { color: #915245; background: #fae9e2; transform: rotate(6deg); }
.learning-poster-bottom { display: flex; align-items: center; justify-content: space-between; color: #526d85; font-size: 20rpx; }
.learning-poster-bottom text:last-child { color: #2b7fd8; font-size: 32rpx; }
.learning-english { font-family: 'Songti SC', 'STSong', serif; font-size: 22rpx; font-weight: 400; margin-left: 6rpx; }
.learning-steps { margin-top: 34rpx; border-top: 1rpx solid #dedbd2; }
.learning-steps > view { display: flex; align-items: flex-start; gap: 24rpx; padding: 25rpx 0; border-bottom: 1rpx solid #dedbd2; }
.learning-step-number { font-family: 'Songti SC', 'STSong', serif; font-size: 25rpx; line-height: 1.7; color: #2b7fd8; }
.learning-steps .entry-copy { margin-top: 3rpx; }
.parenting-entry { padding: 0; text-align: left; background: transparent; }
.music-poster { overflow: hidden; padding: 27rpx 26rpx 24rpx; background: #f5efdc; border-radius: 8rpx; }
.music-poster-top { display: flex; align-items: center; justify-content: space-between; gap: 15rpx; color: #577183; font-size: 16rpx; letter-spacing: 2rpx; }
.music-poster-top text:first-child { color: #2b7fd8; font-weight: 700; }
.music-drawing { position: relative; display: flex; align-items: center; justify-content: center; min-height: 356rpx; padding: 43rpx 37rpx 34rpx; }
.music-note { position: absolute; z-index: 1; color: #2b7fd8; font-family: 'Songti SC', 'STSong', serif; line-height: 1; }
.music-note-one { top: 30rpx; left: 18rpx; font-size: 76rpx; transform: rotate(-15deg); }
.music-note-two { right: 10rpx; bottom: 39rpx; font-size: 66rpx; transform: rotate(14deg); }
.music-spark { position: absolute; right: 38rpx; top: 22rpx; font-size: 43rpx; line-height: 1; color: #aa8630; transform: rotate(8deg); }
.cassette { width: 426rpx; max-width: 100%; padding: 17rpx 21rpx 12rpx; background: #2b7fd8; color: #fefcf6; border: 4rpx solid #246bb4; border-radius: 19rpx 14rpx 17rpx 12rpx; transform: rotate(-6deg); }
.cassette-label { display: flex; flex-direction: column; align-items: center; padding: 12rpx 15rpx 18rpx; background: #fefcf6; color: #225f9c; border-radius: 4rpx 8rpx 3rpx 6rpx; }
.cassette-caption { font-size: 17rpx; letter-spacing: 3rpx; }
.cassette-title { margin-top: 3rpx; font-size: 40rpx; line-height: 1.4; font-weight: 700; background: linear-gradient(transparent 73%, rgba(244,215,88,.8) 73%, rgba(244,215,88,.8) 94%, transparent 94%); }
.cassette-window { position: relative; display: flex; align-items: center; justify-content: space-between; margin: -3rpx 28rpx 0; min-height: 64rpx; padding: 4rpx 6rpx; border: 4rpx solid #205d96; border-radius: 42rpx; background: #f4d758; }
.cassette-reel { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; border: 8rpx solid #fefcf6; border-radius: 50%; background: #2b7fd8; }
.cassette-reel > view { width: 11rpx; height: 11rpx; border-radius: 50%; background: #fefcf6; }
.cassette-tape { position: absolute; left: 46rpx; right: 46rpx; height: 17rpx; border-top: 3rpx solid #a7842b; border-bottom: 3rpx solid #a7842b; }
.cassette-bottom { display: flex; align-items: center; justify-content: space-between; padding-top: 15rpx; font-size: 11rpx; letter-spacing: 2rpx; }
.cassette-bottom > view { width: 7rpx; height: 7rpx; border: 2rpx solid #fefcf6; border-radius: 50%; }
.music-poster-bottom { display: flex; align-items: center; justify-content: space-between; gap: 15rpx; color: #7b735e; font-size: 18rpx; }
.music-poster-bottom text:last-child { color: #2b7fd8; font-size: 14rpx; letter-spacing: 1rpx; white-space: nowrap; }
.music-details { padding-top: 25rpx; }
.music-open { display: flex; align-items: center; justify-content: space-between; margin-top: 25rpx; min-height: 92rpx; padding: 17rpx 28rpx; border-radius: 8rpx; background: #2b7fd8; color: #fefcf6; font-size: 26rpx; font-weight: 600; }
.music-open text:last-child { font-size: 35rpx; font-weight: 400; }
.music-scenes { display: flex; margin-top: 28rpx; padding: 12rpx 0; border-top: 1rpx solid #dedbd2; border-bottom: 1rpx solid #dedbd2; }
.music-scene { flex: 1; min-width: 0; display: flex; align-items: center; gap: 13rpx; min-height: 122rpx; padding: 15rpx 17rpx 15rpx 0; text-align: left; background: transparent; }
.music-scene-sleep { border-left: 1rpx solid #dedbd2; padding-left: 21rpx; padding-right: 0; }
.scene-symbol { color: #2b7fd8; font-size: 49rpx; line-height: 1; flex-shrink: 0; }
.scene-title { color: #333c45; font-size: 26rpx; font-weight: 600; }
.scene-copy { color: #817d76; font-size: 19rpx; margin-top: 4rpx; }
.scene-arrow { margin-left: auto; font-size: 22rpx; color: #2b7fd8; flex-shrink: 0; }
.parenting-note { display: flex; align-items: center; gap: 20rpx; padding: 33rpx 0 42rpx; }
.parenting-note-title { font-size: 26rpx; color: #4a4a5a; }
.parenting-note .entry-copy { margin-top: 2rpx; font-size: 21rpx; }
.visitor-section { padding: 8rpx 0 32rpx; }
.visitor-topline { display: flex; align-items: center; gap: 20rpx; }
.visitor-icon { position: relative; width: 102rpx; height: 102rpx; background: #f0e9d9; border-radius: 50%; overflow: hidden; flex-shrink: 0; }
.visitor-head { position: absolute; width: 28rpx; height: 28rpx; top: 22rpx; left: 37rpx; border: 3rpx solid #a79c84; border-radius: 50%; }
.visitor-body { position: absolute; width: 58rpx; height: 43rpx; top: 57rpx; left: 22rpx; border: 3rpx solid #a79c84; border-radius: 40rpx 40rpx 0 0; }
.visitor-title { font-size: 32rpx; font-weight: 700; }
.visitor-caption { font-size: 22rpx; color: #817d76; margin-top: 4rpx; }
.visitor-badge { margin-left: auto; color: #817550; background: #f4efd9; font-size: 19rpx; padding: 7rpx 13rpx; border-radius: 4rpx; white-space: nowrap; }
.account-note { margin-top: 30rpx; padding: 25rpx 26rpx; background: #f7f3e9; border-radius: 8rpx; }
.account-title { display: flex; align-items: center; gap: 12rpx; font-size: 25rpx; font-weight: 600; }
.status-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #c7ad43; }
.personal-links { border-top: 1rpx solid #dedbd2; margin-bottom: 44rpx; }
.personal-link { display: flex; width: 100%; min-height: 128rpx; align-items: center; justify-content: space-between; gap: 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid #dedbd2; background: transparent; text-align: left; }
.personal-link-title { font-size: 27rpx; }
.personal-link-copy { color: #817d76; font-size: 21rpx; margin-top: 4rpx; }
.home-footer { border-top: 1rpx solid #dedbd2; padding-top: 27rpx; }
.footer-brand { font-size: 22rpx; color: #5f5a53; font-weight: 600; letter-spacing: 1rpx; }
.footer-signature { font-size: 21rpx; color: #817d76; font-style: italic; margin-top: 3rpx; }
.footer-privacy { margin-top: 6rpx; min-height: 44px; display: flex; align-items: center; font-size: 21rpx; }
@media (max-width: 350px) {
  .intro-title { font-size: 44rpx; }
  .category-tab { gap: 2rpx; }
  .tab-english { font-size: 13rpx; }
  .entry-topline { gap: 7rpx; }
  .inspiration-entry { gap: 17rpx; }
  .inspiration-mark { width: 100rpx; }
  .duel-player { width: 200rpx; height: 200rpx; }
  .music-poster { padding-left: 22rpx; padding-right: 22rpx; }
  .music-poster-top { font-size: 15rpx; letter-spacing: 1rpx; }
  .music-drawing { padding-left: 22rpx; padding-right: 22rpx; }
  .music-scene { gap: 10rpx; }
  .music-scene-sleep { padding-left: 17rpx; }
  .scene-title { font-size: 25rpx; }
  .scene-copy { font-size: 18rpx; }
  .scene-arrow { display: none; }
}
@media (min-width: 900px) {
  .photo-cover { height: 640rpx; }
  .category-tab { min-height: 104rpx; }
}

.header-actions { display: flex; align-items: center; gap: 16rpx; flex-shrink: 0; }
.header-actions .header-button { padding-left: 0; }
.header-actions button { flex-shrink: 0; white-space: nowrap; }
.header-account { background: transparent; color: #2b7fd8; font-size: 23rpx; padding: 20rpx 0; min-height: 44px; }
.visitor-auth-actions { display: flex; align-items: stretch; gap: 16rpx; margin-top: 28rpx; }
.visitor-login { flex: 1; background: #2b7fd8; color: #fefcf6; padding: 18rpx 22rpx; border-radius: 8rpx; display: flex; align-items: center; justify-content: space-between; font-size: 24rpx; gap: 14rpx; }
.visitor-register { background: #f3efdf; color: #6d623d; border-radius: 8rpx; padding: 18rpx 22rpx; display: flex; align-items: center; font-size: 24rpx; }
.member-avatar, .member-initial { width: 72rpx; height: 72rpx; border-radius: 50%; flex-shrink: 0; }
.member-initial { display: flex; align-items: center; justify-content: center; background: #f4d758; color: #665421; font-size: 33rpx; }
.member-title-block { flex: 1; min-width: 0; }
.member-title-block .visitor-title, .member-title-block .visitor-caption { overflow-wrap: anywhere; }
.member-account-link { width: 100%; display: flex; align-items: center; justify-content: space-between; color: #2b7fd8; background: transparent; font-size: 24rpx; margin-top: 22rpx; padding: 18rpx 0; border-top: 1rpx solid #dedbd2; }
