<view class="page-shell home-shell">
  <view class="portal-header">
    <view class="brand-lockup">
      <image class="brand-avatar" src="/assets/avatar.png" mode="aspectFill" aria-label="Brclio 品牌头像" />
      <view><view class="brand-title">Brclio <text class="brand-slash">悦创</text></view><view class="brand-caption">收藏影像，保持好奇。</view></view>
    </view>
    <view class="header-actions"><button class="header-account" style="width: auto; display: flex;" bindtap="openAccount" hover-class="button-pressed" aria-label="{{accountUser ? '打开我的账号' : '登录或注册账号'}}">{{accountUser ? '我的账号' : '登录'}}</button><button class="header-button" style="width: auto; display: flex;" bindtap="openAbout" hover-class="button-pressed" aria-label="查看关于 Brclio 悦创">关于 <text aria-hidden="true">↗</text></button></view>
  </view>

  <view class="category-nav" aria-label="内容栏目">
    <button class="category-tab {{activeTab === 'photo' ? 'category-tab-active' : ''}}" data-tab="photo" bindtap="switchTab" hover-class="button-pressed" aria-label="{{activeTab === 'photo' ? '摄影，当前栏目' : '切换到摄影栏目'}}"><text>摄影</text><text class="tab-english">PHOTO</text></button>
    <button class="category-tab {{activeTab === 'relax' ? 'category-tab-active' : ''}}" data-tab="relax" bindtap="switchTab" hover-class="button-pressed" aria-label="{{activeTab === 'relax' ? '放松，当前栏目' : '切换到放松栏目'}}"><text>放松</text><text class="tab-english">PLAY</text></button>
    <button class="category-tab {{activeTab === 'learn' ? 'category-tab-active' : ''}}" data-tab="learn" bindtap="switchTab" hover-class="button-pressed" aria-label="{{activeTab === 'learn' ? '悦学，当前栏目' : '切换到悦学栏目'}}"><text>悦学</text><text class="tab-english">LEARN</text></button>
    <button class="category-tab {{activeTab === 'parenting' ? 'category-tab-active' : ''}}" data-tab="parenting" bindtap="switchTab" hover-class="button-pressed" aria-label="{{activeTab === 'parenting' ? '育儿，当前栏目' : '切换到育儿栏目'}}"><text>育儿</text><text class="tab-english">GROW</text></button>
    <button class="category-tab {{activeTab === 'mine' ? 'category-tab-active' : ''}}" data-tab="mine" bindtap="switchTab" hover-class="button-pressed" aria-label="{{activeTab === 'mine' ? '我的，当前栏目' : '切换到我的栏目'}}"><text>我的</text><text class="tab-english">ME</text></button>
  </view>

  <button class="blog-home-entry" style="width: 100%; display: flex;" data-id="blog" bindtap="openFeature" hover-class="button-pressed" aria-label="打开 Brclio 博客，阅读文章、点赞和收藏"><view class="blog-home-mark serif" aria-hidden="true">✳</view><view class="blog-home-body"><view class="blog-home-title serif">博客 · 把想法写下来</view><view class="blog-home-copy">读一篇文章，留一点思考。</view></view><text class="entry-arrow" aria-hidden="true">↗</text></button>

  <view wx:if="{{activeTab === 'photo'}}" class="tab-content">
    <view class="section-intro">
      <view class="intro-topline"><text class="eyebrow">A WAY OF SEEING</text><text class="issue-number">01 / 摄影</text></view>
      <view class="intro-title serif">把日常，看成<text class="word-highlight">风景。</text></view>
      <view class="intro-copy">光经过的地方，都有值得停留的瞬间。</view>
    </view>
    <button class="photo-feature" style="width: 100%; display: block;" data-id="firstsight" bindtap="openFeature" hover-class="feature-pressed" aria-label="打开 FirstSight 摄影，浏览婚纱与孕期真实摄影图集">
      <view class="photo-cover">
        <image class="cover-image" src="/assets/firstsight-cover.jpg" mode="aspectFill" aria-label="海边誓约真实婚纱摄影封面" />
        <view class="cover-caption"><text>FIRSTSIGHT</text><text>光影里的故事</text></view>
        <view class="cover-open" aria-hidden="true">↗</view>
      </view>
      <view class="photo-details"><view><view class="feature-title serif">{{featured.title}}</view><view class="feature-subtitle">婚纱 · 孕期 · 真实影像</view></view><view class="photo-action">进入图集 <text aria-hidden="true">→</text></view></view>
    </button>
    <button class="inspiration-entry" style="width: 100%; display: flex;" data-id="wedding-inspiration" bindtap="openFeature" hover-class="button-pressed" aria-label="打开孕期影像，41 张真实摄影照片">
      <view class="inspiration-mark" aria-hidden="true"><text>41</text><text class="mark-small">MOMENTS</text></view>
      <view class="entry-body"><view class="entry-topline"><text class="entry-title serif">孕期影像</text><text class="ai-badge">真实摄影</text></view><view class="entry-copy">倾听你的心跳。<view>把期待，留在这一刻。</view></view></view><text class="entry-arrow" aria-hidden="true">↗</text>
    </button>
    <view class="editorial-note"><text class="note-symbol" aria-hidden="true">✳</text><view>不赶路的时候，<text class="note-emphasis">让目光多停留一会儿。</text></view></view>
  </view>

  <view wx:elif="{{activeTab === 'relax'}}" class="tab-content">
    <view class="section-intro"><view class="intro-topline"><text class="eyebrow">A LITTLE BREAK</text><text class="issue-number">02 / 放松</text></view><view class="intro-title serif">认真生活，<text class="word-highlight">轻松一下。</text></view><view class="intro-copy">把手机放在中间，叫上身边的那个人。</view></view>
    <button class="duel-entry" style="width: 100%; display: block;" data-id="ready-go-duel" bindtap="openFeature" hover-class="feature-pressed" aria-label="开始双人反应挑战，两人在同一设备上游玩，无需注册或登录">
      <view class="duel-visual" aria-hidden="true">
        <view class="duel-visual-top"><text class="game-label">READY. GO. DUEL.</text><text class="game-edition">NO. 001</text></view>
        <view class="duel-court"><view class="duel-player player-one"><text>01</text><text class="player-caption">准备好了吗</text></view><view class="duel-versus serif">vs.</view><view class="duel-player player-two"><text>02</text><text class="player-caption">就等你了</text></view></view>
        <view class="duel-bottom"><text class="duel-dot"></text><text>注意信号，看看谁更快。</text></view>
      </view>
      <view class="game-details"><view class="entry-topline"><text class="feature-title serif">双人反应挑战</text><text class="small-label">同屏双人</text></view><view class="game-copy">一部手机，两个人。等待信号，再出手。</view><view class="game-tags"><text>触摸 / 无限模式</text><text>惊喜彩头</text><text>原作音效</text></view><view class="game-action"><text>来一局</text><text aria-hidden="true">↗</text></view></view>
    </button>
    <view class="play-note"><text class="small-label">玩法很简单</text><view class="play-note-title serif">面对面，才好玩。</view><view class="entry-copy">两人在同一部设备上操作，无需匹配。<view>还可进入计分扩展，保留最近 20 场本机战绩。</view></view></view>
  </view>

  <view wx:elif="{{activeTab === 'learn'}}" class="tab-content">
    <view class="section-intro"><view class="intro-topline"><text class="eyebrow">A LITTLE EVERY DAY</text><text class="issue-number">03 / 悦学</text></view><view class="intro-title serif">每天学一点，<view><text class="word-highlight">好奇多一点。</text></view></view><view class="intro-copy">让单词在指尖重逢，把记忆变成小小收获。</view></view>
    <button class="learning-entry" style="width: 100%; display: block;" data-id="lingotiles" bindtap="openFeature" hover-class="feature-pressed" aria-label="打开词了个词 LingoTiles，先记忆词表，再配对英文、词性与中文，支持主题和分级闯关">
      <view class="learning-poster" aria-hidden="true">
        <view class="learning-poster-top"><text>LINGOTILES</text><text>LEARN / 001</text></view>
        <view class="learning-poster-title serif">词了<text>个词。</text></view>
        <view class="learning-tile-row"><text class="learning-tile learning-tile-word">apple</text><text class="learning-tile learning-tile-pos">n.</text><text class="learning-tile learning-tile-meaning">苹果</text></view>
        <view class="learning-poster-bottom"><text>三个部分，一次记住。</text><text>↗</text></view>
      </view>
      <view class="game-details"><view class="entry-topline"><text class="feature-title serif">词了个词 <text class="learning-english">LingoTiles</text></text><text class="small-label">记忆 × 配对</text></view><view class="game-copy">先记忆，再消除。每一次配对，都是一次回想。</view><view class="game-tags"><text>经典六关</text><text>分级闯关</text><text>单词本与收藏</text></view><view class="game-action"><text>开始学习</text><text aria-hidden="true">↗</text></view></view>
    </button>
    <view class="learning-steps"><view><text class="learning-step-number">01</text><view><view class="entry-title serif">先看一眼</view><view class="entry-copy">选择主题或学习阶段，记住本关词表。</view></view></view><view><text class="learning-step-number">02</text><view><view class="entry-title serif">让三张牌重逢</view><view class="entry-copy">英文、词性与中文含义，配成一组。</view></view></view><view><text class="learning-step-number">03</text><view><view class="entry-title serif">把收获留下</view><view class="entry-copy">翻单词本、收藏生词，回看通关足迹。</view></view></view></view>
    <view class="editorial-note"><text class="note-symbol" aria-hidden="true">✳</text><view>一点点积累，<text class="note-emphasis">也会长成自己的风景。</text></view></view>
  </view>

  <view wx:elif="{{activeTab === 'parenting'}}" class="tab-content parenting-content">
    <view class="section-intro"><view class="intro-topline"><text class="eyebrow">GROW TOGETHER</text><text class="issue-number">04 / 育儿</text></view><view class="intro-title serif">读懂孩子，<view><text class="word-highlight">一起成长。</text></view></view><view class="intro-copy">从日常的小问题开始，慢慢学会更好的陪伴。</view></view>
    <button class="parenting-guide-entry" style="width: 100%; display: block; margin: 0;" data-id="parenting-guide" bindtap="openFeature" hover-class="feature-pressed" aria-label="阅读悦创育儿宝典文字专栏">
      <view class="guide-entry-topline"><text class="guide-entry-label">PARENTING NOTES</text><text class="guide-entry-format">文字专栏</text></view>
      <view class="guide-entry-title serif">悦创育儿宝典</view>
      <view class="guide-entry-copy">了解孩子的成长，也找到适合自己的养育方式。</view>
      <view class="guide-entry-topics">智力发展 · 情绪管理 · 亲子沟通</view>
      <view class="guide-entry-bottom"><text>打开专栏目录</text><text aria-hidden="true">→</text></view>
    </button>
    <view class="parenting-source">悦创育儿宝典 · 文字整理版</view>
    <view class="parenting-links"><button class="nursery-text-link" style="width: auto; display: flex; margin: 0;" data-id="nursery-music" bindtap="openFeature" hover-class="button-pressed" aria-label="儿歌陪伴，打开音乐播放器">儿歌陪伴 →</button></view>
  </view>

  <view wx:else class="tab-content">
    <view class="section-intro"><view class="intro-topline"><text class="eyebrow">YOUR LITTLE CORNER</text><text class="issue-number">05 / 我的</text></view><view class="intro-title serif">给喜欢的事，<view><text class="word-highlight">留个位置。</text></view></view></view>
    <view wx:if="{{accountUser}}" class="visitor-section member-section">
      <view class="visitor-topline"><image wx:if="{{accountUser.avatarUrl}}" class="member-avatar" src="{{accountUser.avatarUrl}}" mode="aspectFill" /><view wx:else class="member-initial serif" aria-hidden="true">{{accountInitial}}</view><view class="member-title-block"><view class="visitor-title serif">你好，{{accountLabel}}。</view><view class="visitor-caption">{{accountUser.email || '微信账号已登录'}}</view></view><text class="visitor-badge">已登录</text></view>
      <button class="member-account-link" style="width: 100%; display: flex;" bindtap="openAccount" hover-class="button-pressed"><text>管理我的账号</text><text aria-hidden="true">→</text></button>
      <view class="entry-copy">{{syncMessage || '记录先存本机，联网后自动同步到你的账号。'}}</view>
    </view>
    <view wx:else class="visitor-section">
      <view class="visitor-topline"><view class="visitor-icon" aria-hidden="true"><view class="visitor-head"></view><view class="visitor-body"></view></view><view><view class="visitor-title serif">你好，访客。</view><view class="visitor-caption">现在，随心逛逛。</view></view><text class="visitor-badge">访客模式</text></view>
      <view class="visitor-auth-actions"><button class="visitor-login" style="display: flex; flex: 1;" bindtap="openAccount" hover-class="button-pressed">登录 / 微信登录 <text aria-hidden="true">→</text></button><button class="visitor-register" style="display: flex; width: auto;" data-mode="register" bindtap="openAccount" hover-class="button-pressed">注册账号</button></view>
      <view class="account-note"><view class="account-title"><text class="status-dot" aria-hidden="true"></text>记录，先留在这台设备</view><view class="entry-copy">摄影、挑战、学习与儿歌，都可以随心打开。<view>登录后自动同步进度和记录，换设备也能继续。</view></view></view>
    </view>
    <view class="personal-links">
      <button class="personal-link" style="width: 100%; display: flex;" bindtap="openBlogFavorites" hover-class="button-pressed"><view><view class="personal-link-title">我收藏的文章</view><view class="personal-link-copy">网页和小程序共享你的阅读收藏</view></view><text class="entry-arrow" aria-hidden="true">↗</text></button>
      <button class="personal-link" style="width: 100%; display: flex;" data-id="content-hub" bindtap="openFeature" hover-class="button-pressed" aria-label="浏览全部已发布的内容与项目"><view><view class="personal-link-title">全部内容</view><view class="personal-link-copy">摄影、放松、悦学与育儿，随时回来看看</view></view><text class="entry-arrow" aria-hidden="true">↗</text></button>
      <button class="personal-link" style="width: 100%; display: flex;" bindtap="openAbout" hover-class="button-pressed" aria-label="查看关于 Brclio 悦创与服务信息"><view><view class="personal-link-title">关于悦创</view><view class="personal-link-copy">从摄影开始，慢慢生长</view></view><text class="entry-arrow" aria-hidden="true">↗</text></button>
      <button class="personal-link" style="width: 100%; display: flex;" bindtap="openPrivacy" hover-class="button-pressed" aria-label="查看隐私、权限与本机数据说明"><view><view class="personal-link-title">隐私与数据</view><view class="personal-link-copy">了解权限与本机记录</view></view><text class="entry-arrow" aria-hidden="true">↗</text></button>
    </view>
  </view>

  <view class="home-footer"><view class="footer-brand">Brclio / 悦创</view><view class="footer-signature serif">A small space for everyday wonders.</view><button class="text-button footer-privacy" bindtap="openPrivacy" hover-class="button-pressed" aria-label="查看隐私与数据说明">隐私与数据说明</button></view>
</view>
