<view class="page-shell nursery-shell">
  <view class="nursery-heading"><view><text class="eyebrow">LITTLE MOMENTS / 育儿</text><view class="nursery-title serif">把陪伴，唱成歌。</view><view class="nursery-intro">熟悉的旋律，陪宝贝慢慢长大。</view></view><view class="library-stamp"><text class="stamp-count serif">{{total}}</text><text class="stamp-unit">首儿歌</text></view></view>

  <view class="music-player" id="music-player">
    <view class="player-topline"><text class="player-label">儿歌陪伴</text><view class="player-status"><text class="status-light {{isPlaying ? 'status-light-on' : ''}}"></text><text>{{statusText}}</text></view></view>
    <view class="now-playing">
      <image wx:if="{{!coverFailures[currentSong.id]}}" class="now-cover" src="{{currentSong.cover}}" mode="aspectFill" data-id="{{currentSong.id}}" binderror="onCoverError" aria-label="{{currentSong.title}}的歌曲封面" />
      <view wx:else class="now-cover cover-fallback" aria-hidden="true">♪</view>
      <view class="now-song"><view class="now-caption">{{isPlaying ? 'NOW PLAYING' : 'READY TO PLAY'}}</view><view class="now-title serif">{{currentSong.title}}</view><view class="now-artist">{{currentSong.artist}} · {{currentSong.scene === 'sleep' ? '睡前轻听' : '快乐陪伴'}}</view></view>
      <button class="favorite-button {{favorite ? 'is-favorite' : ''}}" style="width: auto; display: flex;" bindtap="toggleFavorite" hover-class="button-pressed" aria-label="{{favorite ? '取消收藏当前歌曲' : '收藏当前歌曲'}}"><text aria-hidden="true">{{favorite ? '♥' : '♡'}}</text></button>
    </view>
    <view class="seek-area"><slider class="music-slider" min="0" max="{{duration || 1}}" step="1" value="{{currentTime}}" disabled="{{status === 'idle' || status === 'error'}}" bindchanging="previewSeek" bindchange="seekSong" activeColor="#2b7fd8" backgroundColor="#cbdceb" block-color="#2b7fd8" block-size="16" aria-label="歌曲播放进度" /><view class="time-row"><text>{{currentTimeText}}</text><text>{{durationText}}</text></view></view>
    <view class="playback-controls">
      <button class="skip-button" style="width: auto; display: flex;" bindtap="previousSong" hover-class="button-pressed" aria-label="上一首"><view class="skip-icon skip-back" aria-hidden="true"><view class="skip-triangle"></view></view><text>上一首</text></button>
      <button class="main-play-button" style="width: 60px; display: flex;" bindtap="togglePlayback" hover-class="button-pressed" aria-label="{{isPlaying || isLoading ? '暂停播放' : '播放儿歌'}}"><view wx:if="{{isPlaying || isLoading}}" class="pause-icon" aria-hidden="true"><view class="pause-bar"></view><view class="pause-bar"></view></view><view wx:else class="play-icon" aria-hidden="true"></view></button>
      <button class="skip-button" style="width: auto; display: flex;" bindtap="nextSong" hover-class="button-pressed" aria-label="下一首"><view class="skip-icon" aria-hidden="true"><view class="skip-triangle"></view></view><text>下一首</text></button>
    </view>
    <view class="player-tools"><button class="player-tool" style="width: auto; display: flex;" bindtap="changeMode" hover-class="button-pressed" aria-label="切换播放模式，当前{{modeText}}"><text class="tool-symbol" aria-hidden="true">{{mode === 'shuffle' ? '⤨' : mode === 'repeat-one' ? '↻' : '⇄'}}</text><text>{{modeText}}</text></button><view class="tool-divider"></view><button class="player-tool timer-tool" style="width: auto; display: flex;" bindtap="chooseSleepTimer" hover-class="button-pressed" aria-label="设置定时停止，当前{{sleepText}}"><text class="tool-symbol" aria-hidden="true">◷</text><text>{{sleepText}}</text></button></view>
  </view>
  <view wx:if="{{error}}" class="audio-error" role="alert"><view><view class="error-title">这首歌暂时没能播放</view><view class="error-copy">{{error}}</view></view><button class="retry-button" style="width: auto; display: flex;" bindtap="retryPlayback" hover-class="button-pressed">重试</button></view>
  <view wx:if="{{sleepActive}}" class="storage-notice">定时停止需保持小程序在前台。</view>
  <view wx:if="{{audioBackend === 'inner'}}" class="storage-notice">当前微信仅支持前台播放。</view>
  <view wx:if="{{storageNotice}}" class="storage-notice" role="alert">{{storageNotice}}</view>
  <view class="listening-note"><text class="note-note" aria-hidden="true">♪</text><text>点一下就播放，让旋律陪你腾出双手。</text></view>

  <view class="scene-section"><view class="section-heading"><view class="section-title serif">此刻，想听什么？</view><text class="section-english">PICK A MOOD</text></view><view class="scene-tabs"><button wx:for="{{scenes}}" wx:key="id" class="scene-tab {{scene === item.id ? 'scene-selected' : ''}}" style="display: flex;" data-scene="{{item.id}}" bindtap="switchScene" hover-class="button-pressed" aria-label="{{item.title}}{{scene === item.id ? '，已选择' : ''}}"><text class="scene-symbol" aria-hidden="true">{{item.symbol}}</text><text>{{item.title}}</text></button></view></view>

  <view class="playlist-section"><view class="section-heading playlist-heading"><view class="section-title serif">{{listTitle}}<text class="song-count">{{songs.length}} 首</text></view><text class="playlist-hint">点歌即播</text></view><view class="song-search"><text class="search-symbol" aria-hidden="true"></text><input class="search-input" value="{{query}}" bindinput="searchSongs" placeholder="搜索歌名，比如 小星星" placeholder-class="search-placeholder" maxlength="80" confirm-type="search" aria-label="搜索儿歌歌名" /><button wx:if="{{query}}" class="clear-search" style="width: auto; display: flex;" bindtap="clearSearch" hover-class="button-pressed" aria-label="清空搜索">×</button></view>
    <view class="song-list">
      <view wx:for="{{songs}}" wx:key="id" class="song-row {{item.selected ? 'song-selected' : ''}}"><button class="song-pick" style="display: flex; flex: 1;" data-id="{{item.id}}" bindtap="playSong" hover-class="song-pressed" aria-label="{{item.playing ? '暂停' : '播放'}}{{item.title}}"><view class="song-art"><image wx:if="{{!coverFailures[item.id]}}" class="song-cover" src="{{item.cover}}" mode="aspectFill" lazy-load="true" data-id="{{item.id}}" binderror="onCoverError" aria-hidden="true" /><view wx:else class="song-cover cover-fallback" aria-hidden="true">♪</view><view wx:if="{{item.playing}}" class="song-playing-mark" aria-hidden="true"><view class="sound-bars"><view class="sound-bar"></view><view class="sound-bar sound-bar-tall"></view><view class="sound-bar sound-bar-short"></view></view></view></view><view class="song-info"><view class="song-title">{{item.title}}</view><view class="song-meta">{{item.sceneLabel}}<text>·</text>{{item.durationText}}</view></view><view class="row-play" aria-hidden="true"><view wx:if="{{item.playing}}" class="small-pause"><view class="small-pause-bar"></view><view class="small-pause-bar"></view></view><view wx:else class="small-play"></view></view></button><button class="row-favorite {{item.favorite ? 'is-favorite' : ''}}" style="width: auto; display: flex;" data-id="{{item.id}}" bindtap="toggleFavorite" hover-class="button-pressed" aria-label="{{item.favorite ? '取消收藏' : '收藏'}}{{item.title}}">{{item.favorite ? '♥' : '♡'}}</button></view>
    </view>
    <view wx:if="{{!songs.length}}" class="empty-songs"><text class="empty-symbol" aria-hidden="true">{{query ? '♪' : '♡'}}</text><view class="empty-title serif">{{emptyTitle}}</view><view class="empty-copy">{{emptyCopy}}</view></view>
  </view>
  <view class="nursery-footer"><text>Brclio / 儿歌陪伴</text><text>小小旋律，长长陪伴。</text></view>
</view>
<view wx:if="{{compact && status !== 'idle'}}" class="compact-player"><button class="compact-song" style="display: flex; flex: 1;" bindtap="scrollToPlayer" hover-class="button-pressed" aria-label="回到播放器"><image wx:if="{{!coverFailures[currentSong.id]}}" class="compact-disc" src="{{currentSong.cover}}" mode="aspectFill" data-id="{{currentSong.id}}" binderror="onCoverError" aria-hidden="true" /><view wx:else class="compact-disc cover-fallback" aria-hidden="true">♪</view><view class="compact-song-body"><view class="compact-title">{{currentSong.title}}</view><view class="compact-status">{{statusText}}</view></view></button><button class="compact-toggle" style="width: auto; display: flex;" bindtap="togglePlayback" hover-class="button-pressed" aria-label="{{isPlaying || isLoading ? '暂停播放' : '继续播放'}}"><view wx:if="{{isPlaying || isLoading}}" class="small-pause" aria-hidden="true"><view class="small-pause-bar"></view><view class="small-pause-bar"></view></view><view wx:else class="small-play" aria-hidden="true"></view></button><button class="compact-next" style="width: auto; display: flex;" bindtap="nextSong" hover-class="button-pressed" aria-label="下一首"><view class="skip-icon" aria-hidden="true"><view class="skip-triangle"></view></view></button></view>
