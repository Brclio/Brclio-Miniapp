<view class="page-shell blog-shell">
  <view class="channel-head">
    <view class="channel-brand"><view class="channel-mark serif" aria-hidden="true">b.</view><view><view class="channel-title serif">Brclio 的文字</view><view class="channel-note">写代码，教编程，做产品</view></view></view>
    <button class="blog-account" bindtap="openAccount" hover-class="blog-pressed" aria-label="{{user ? '打开我的账号' : '登录悦创账号'}}">{{user ? '我的' : '登录'}}<text class="account-arrow">↗</text></button>
  </view>

  <view class="blog-tabs" role="tablist" aria-label="阅读收藏">
    <view class="blog-tab {{!saved ? 'is-selected' : ''}}" role="tab" aria-selected="{{!saved}}" data-view="all" bindtap="switchView" hover-class="blog-pressed">全部文章<view wx:if="{{!saved}}" class="tab-line"></view></view>
    <view class="blog-tab {{saved ? 'is-selected' : ''}}" role="tab" aria-selected="{{saved}}" data-view="saved" bindtap="switchView" hover-class="blog-pressed">我的收藏<view wx:if="{{saved}}" class="tab-line"></view></view>
  </view>

  <view class="blog-search">
    <view class="search-glyph" aria-hidden="true"></view>
    <input class="blog-search-input" value="{{query}}" bindinput="inputSearch" bindconfirm="search" maxlength="100" confirm-type="search" placeholder="搜索文章、标签或一个想法" placeholder-class="search-placeholder" aria-label="搜索文章" />
    <button class="blog-search-submit" bindtap="search" hover-class="blog-pressed" aria-label="搜索文章"><text>↵</text></button>
  </view>

  <scroll-view wx:if="{{categories.length}}" class="blog-filter-scroll" scroll-x="true" show-scrollbar="{{false}}">
    <view class="blog-filters"><view class="blog-filter {{!category ? 'is-selected' : ''}}" role="button" aria-label="全部分类" data-category="" bindtap="selectCategory" hover-class="blog-pressed"><text>全部</text></view><view wx:for="{{categories}}" wx:key="*this" class="blog-filter {{category === item ? 'is-selected' : ''}}" role="button" aria-label="分类 {{item}}" data-category="{{item}}" bindtap="selectCategory" hover-class="blog-pressed"><text>{{item}}</text></view></view>
  </scroll-view>
  <scroll-view wx:if="{{tags.length}}" class="blog-tags-scroll" scroll-x="true" show-scrollbar="{{false}}"><view class="blog-tags"><view wx:for="{{tags}}" wx:key="*this" class="blog-tag {{tag === item ? 'is-selected' : ''}}" role="button" aria-label="标签 {{item}}" data-tag="{{item}}" bindtap="selectTag" hover-class="blog-pressed"># {{item}}</view></view></scroll-view>

  <view class="collection-heading"><view>{{saved ? '收藏的文字' : '最近的记录'}}<text>{{total}} 篇</text></view><button wx:if="{{query || category || tag}}" class="collection-link" bindtap="clearFilters">清除筛选</button><button wx:else class="collection-link" bindtap="reload" aria-label="读取最新文章">刷新 ↻</button></view>

  <view wx:if="{{error}}" class="blog-state blog-error" role="alert"><text>{{error}}</text><button wx:if="{{saved && !user}}" class="blog-retry" bindtap="openAccount">登录后查看收藏</button><button wx:else class="blog-retry" bindtap="reload">重新加载</button></view>
  <view class="blog-posts">
    <view wx:for="{{posts}}" wx:key="id" class="post-card {{item.coverUrl ? 'post-card-with-cover' : 'post-card-text'}}" role="button" data-id="{{item.id}}" bindtap="openPost" hover-class="post-card-pressed" aria-label="阅读 {{item.title}}，{{item.counts.views}} 次阅读">
      <view class="post-card-main">
        <image wx:if="{{item.coverUrl}}" class="post-card-cover" src="{{item.coverUrl}}" mode="aspectFill" lazy-load="true" />
        <view class="post-card-body"><view class="post-card-title serif">{{item.title}}</view><view wx:if="{{item.excerpt}}" class="post-card-excerpt">{{item.excerpt}}</view></view>
      </view>
      <view class="post-card-details"><text>{{item.dateText}}</text><text class="meta-dot">·</text><text>{{item.category || '随笔'}}</text><text class="post-card-minutes">{{item.readingMinutes}} 分钟</text></view>
      <view class="post-card-stats"><view><text class="stat-label">阅读</text><text>{{item.counts.views}}</text></view><view><text class="stat-label">点赞</text><text>{{item.counts.likes}}</text></view><view><text class="stat-label">收藏</text><text>{{item.counts.favorites}}</text></view></view>
    </view>
  </view>
  <view wx:if="{{loading}}" class="blog-state" aria-live="polite">正在找来文字…</view>
  <view wx:elif="{{!posts.length && !error}}" class="blog-empty"><view class="empty-mark serif">b.</view><view class="empty-title serif">{{saved ? '收藏一点，想再读的文字。' : '下一篇文字，正在路上。'}}</view><view class="empty-copy">{{query || category || tag ? '换个关键词，或清除筛选再看看。' : saved ? '在阅读页点一下星星，就能在这里找到。' : '留一点空间，给新的想法。'}}</view></view>
  <button wx:if="{{hasMore && !loading}}" class="blog-load-more" bindtap="loadMore" hover-class="blog-pressed">继续阅读 <text>↓</text></button>
  <view wx:if="{{posts.length && !hasMore && !loading}}" class="blog-list-end">— 读到这里，刚刚好 —</view>
  <button wx:if="{{canWrite}}" class="blog-writing" bindtap="copyWritingUrl" hover-class="blog-pressed"><text>去网页写篇文章</text><text>↗</text></button>
  <view class="blog-signature">Stay curious. Keep building.</view>
</view>
