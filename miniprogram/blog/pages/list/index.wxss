/* Brclio Design System app, filter and editorial-card adaptations. CC BY-NC-SA 4.0. */
page { background: #f5f4ee; }
.blog-shell { max-width: 920rpx; padding: 24rpx 28rpx 48rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.blog-shell button { box-sizing: border-box; display: flex; flex: none; align-items: center; justify-content: center; width: auto; min-width: 0; max-width: none; height: auto; min-height: 0; margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; color: inherit; font-size: inherit; font-weight: 400; line-height: 1.5; overflow: visible; }
.blog-shell button::after { border: 0; }
.blog-shell .blog-pressed { opacity: .6; }
.channel-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 12rpx 8rpx 26rpx; }
.channel-brand { display: flex; align-items: center; gap: 18rpx; min-width: 0; }
.channel-mark { display: flex; align-items: center; justify-content: center; width: 70rpx; height: 70rpx; flex: none; font-size: 58rpx; font-style: italic; line-height: 1; letter-spacing: -6rpx; color: #2b7fd8; }
.channel-title { font-size: 35rpx; line-height: 1.45; font-weight: 700; color: #292b33; }
.channel-note { margin-top: 6rpx; font-size: 21rpx; line-height: 1.5; color: #6b7267; }
.blog-shell .blog-account { min-width: 100rpx; min-height: 88rpx; gap: 5rpx; color: #626b75; font-size: 23rpx; white-space: nowrap; }
.account-arrow { color: #2b7fd8; font-size: 27rpx; }
.blog-tabs { display: flex; align-items: center; gap: 42rpx; padding: 0 12rpx; border-bottom: 1rpx solid #e6e5dd; }
.blog-tab { position: relative; display: flex; align-items: center; min-height: 88rpx; padding: 0 2rpx; font-size: 27rpx; color: #92958e; }
.blog-tab.is-selected { color: #283e56; font-weight: 600; }
.tab-line { position: absolute; left: 0; right: 0; bottom: -1rpx; height: 4rpx; border-radius: 4rpx; background: #2b7fd8; }
.blog-search { display: flex; align-items: center; gap: 18rpx; height: 88rpx; padding-left: 26rpx; margin: 26rpx 2rpx 8rpx; background: #eaeae3; border-radius: 20rpx; }
.search-glyph { position: relative; width: 26rpx; height: 26rpx; flex: none; border: 2.5rpx solid #91978f; border-radius: 50%; margin-right: 3rpx; }
.search-glyph::after { position: absolute; right: -8rpx; bottom: -5rpx; content: ''; width: 13rpx; height: 2.5rpx; border-radius: 2rpx; background: #91978f; transform: rotate(45deg); }
.blog-search-input { display: block; flex: 1; width: 0; min-width: 0; height: 88rpx; font-size: 25rpx; color: #343b40; }
.search-placeholder { color: #969b92; }
.blog-shell .blog-search-submit { flex: none; width: 84rpx; height: 88rpx; color: #737e7a; font-size: 34rpx; }
.blog-filter-scroll, .blog-tags-scroll { display: block; width: 100%; white-space: nowrap; }
.blog-filters { display: inline-flex; align-items: center; padding: 6rpx 4rpx 0; }
.blog-filter { display: inline-flex; align-items: center; flex: none; min-height: 76rpx; margin-right: 12rpx; font-size: 23rpx; color: #6b7267; }
.blog-filter text { display: block; padding: 8rpx 20rpx; line-height: 1.5; border-radius: 30rpx; }
.blog-filter.is-selected text { color: #2b7fd8; background: #e6edf3; font-weight: 600; }
.blog-tags { display: inline-flex; align-items: center; padding: 0 12rpx; }
.blog-tag { display: inline-flex; align-items: center; flex: none; min-height: 64rpx; margin-right: 26rpx; font-size: 21rpx; color: #6b7267; }
.blog-tag.is-selected { color: #2b7fd8; }
.collection-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 18rpx 10rpx 16rpx; font-size: 24rpx; font-weight: 500; color: #6b7267; }
.collection-heading text { font-size: 20rpx; font-weight: 400; margin-left: 14rpx; color: #6b7267; }
.blog-shell .collection-link { min-height: 64rpx; font-size: 21rpx; color: #6b7267; }
.post-card { display: block; width: 100%; margin-bottom: 20rpx; padding: 28rpx 26rpx 18rpx; border: 1rpx solid #e9e8df; border-radius: 18rpx; background: #fffdf8; overflow: hidden; }
.post-card-pressed { background: #f8f9f3; }
.post-card-main { display: flex; align-items: flex-start; gap: 22rpx; width: 100%; }
.post-card-cover { display: block; flex: none; width: 172rpx; height: 176rpx; border-radius: 10rpx; background: #f0efe7; }
.post-card-body { display: block; flex: 1; width: 0; min-width: 0; }
.post-card-text .post-card-main { display: block; }
.post-card-text .post-card-body { width: 100%; }
.post-card-title { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; font-size: 33rpx; line-height: 1.55; font-weight: 700; color: #303238; overflow-wrap: anywhere; }
.post-card-excerpt { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; margin-top: 12rpx; font-size: 25rpx; line-height: 1.7; color: #6b7267; overflow-wrap: anywhere; }
.post-card-details { display: flex; align-items: center; gap: 12rpx; margin-top: 22rpx; padding-bottom: 18rpx; border-bottom: 1rpx solid #efeee8; font-size: 20rpx; line-height: 1.5; color: #70776b; }
.meta-dot { color: #b3b8ae; }
.post-card-minutes { margin-left: auto; }
.post-card-stats { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding-top: 15rpx; font-size: 20rpx; line-height: 1.5; color: #6b7267; }
.post-card-stats > view { display: flex; align-items: center; gap: 8rpx; }
.stat-label { color: #70776b; }
.blog-state { padding: 38rpx 20rpx; text-align: center; font-size: 24rpx; color: #8b9388; }
.blog-error { color: #a64552; line-height: 1.8; }
.blog-shell .blog-retry { min-height: 88rpx; padding: 0 24rpx; margin: 16rpx auto 0; color: #2b7fd8; font-size: 24rpx; }
.blog-empty { padding: 68rpx 20rpx 58rpx; text-align: center; }
.empty-mark { color: #2b7fd8; font-size: 74rpx; font-style: italic; letter-spacing: -5rpx; line-height: 1; }
.empty-title { margin: 28rpx 0 14rpx; font-size: 30rpx; font-weight: 600; color: #4c554d; }
.empty-copy { font-size: 23rpx; line-height: 1.8; color: #92998d; }
.blog-shell .blog-load-more { width: 100%; min-height: 88rpx; margin-top: 10rpx; gap: 14rpx; color: #6c8270; font-size: 24rpx; }
.blog-list-end { text-align: center; color: #a4ab9f; font-size: 20rpx; padding: 26rpx 0; }
.blog-shell .blog-writing { width: 100%; justify-content: space-between; min-height: 88rpx; margin-top: 20rpx; padding: 0 12rpx; border-top: 1rpx solid #e4e5dc; color: #2b7fd8; font-size: 23rpx; }
.blog-signature { padding-top: 22rpx; text-align: center; font-family: Georgia, serif; font-size: 20rpx; font-style: italic; color: #a0a798; }
@media (max-width: 350px) { .blog-shell { padding-left: 22rpx; padding-right: 22rpx; } .post-card { padding-left: 24rpx; padding-right: 24rpx; } .post-card-cover { width: 150rpx; height: 168rpx; } .post-card-title { font-size: 31rpx; } .post-card-main { gap: 18rpx; } }
@media (min-width: 900px) { .blog-shell { max-width: 760px; } }
