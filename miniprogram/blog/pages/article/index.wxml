<view class="page-shell article-shell">
  <view class="article-nav"><button class="article-nav-link" bindtap="openList" hover-class="reader-pressed">‹ 博客列表</button><button class="article-nav-link article-copy" bindtap="copyLink" hover-class="reader-pressed">复制链接 ↗</button></view>
  <view wx:if="{{loading && !post}}" class="reader-state" aria-live="polite">正在打开文章…</view>
  <view wx:if="{{error}}" class="reader-state reader-error" role="alert"><text>{{error}}</text><button class="reader-retry" bindtap="reload">重新加载</button></view>
  <block wx:if="{{post}}">
    <view class="article-header">
      <view class="reader-author"><image wx:if="{{post.author.avatarUrl}}" src="{{post.author.avatarUrl}}" class="reader-avatar" mode="aspectFill" /><view wx:else class="reader-avatar reader-avatar-fallback serif" aria-hidden="true">b.</view><view class="reader-author-info"><view class="reader-author-name">{{post.author.displayName}}</view><view class="reader-date">{{post.dateText}}<text>·</text>{{post.readingMinutes}} 分钟阅读</view></view><text class="reader-category">{{post.category || '随笔'}}</text></view>
      <view wx:if="{{post.status !== 'published'}}" class="reader-draft">草稿 · 仅管理员可见</view>
      <view class="reader-title serif" selectable="true">{{post.title}}</view>
      <view wx:if="{{post.excerpt}}" class="reader-excerpt">{{post.excerpt}}</view>
      <view wx:if="{{post.tags.length}}" class="reader-tags"><text wx:for="{{post.tags}}" wx:key="*this"># {{item}}</text></view>
    </view>
    <image wx:if="{{post.coverUrl}}" class="reader-cover" src="{{post.coverUrl}}" mode="widthFix" />
    <view class="reader-content"><rich-text wx:for="{{htmlChunks}}" wx:key="key" nodes="{{item.html}}" user-select="true" space="nbsp" /></view>
    <view wx:if="{{contentLoading}}" class="reader-state" aria-live="polite">正在排版正文…</view>
    <view class="reader-end"><view class="reader-end-line"></view><text>感谢阅读</text><view class="reader-end-line"></view></view>
    <view class="reader-footnote"><text>{{post.counts.views}} 次阅读</text><button wx:if="{{canEdit}}" class="reader-edit" bindtap="copyWritingUrl" hover-class="reader-pressed">在网页编辑 ↗</button></view>
    <view wx:if="{{actionError}}" class="reader-action-error" role="alert">{{actionError}}</view>

    <view id="comments-section" class="reader-comments">
      <view class="reader-comments-heading"><view>想法与回应<text>{{post.counts.comments}}</text></view><view class="comments-heading-note">保持友善，认真交流</view></view>
      <view wx:if="{{post.commentsEnabled && post.status === 'published'}}" id="comment-compose" class="reader-compose"><textarea id="comment-input" class="reader-comment-input" value="{{commentText}}" focus="{{commentFocused}}" bindinput="inputComment" bindblur="blurComment" maxlength="1000" placeholder="读到这里，想说点什么…" placeholder-class="comment-placeholder" aria-label="写评论，最多 1000 字" auto-height="true" cursor-spacing="120" adjust-position="true" /><view class="reader-compose-footer"><text>{{commentText.length}} / 1000</text><button class="reader-comment-submit" bindtap="submitComment" loading="{{commentBusy}}" disabled="{{commentBusy || !!reactionBusy}}" hover-class="reader-pressed">{{user ? '发布评论' : '登录后发布'}}</button></view></view>
      <view wx:elif="{{post.status === 'published'}}" class="reader-comments-closed">作者已关闭新评论，已有回应仍可阅读。</view>
      <view wx:if="{{commentsError}}" class="reader-state reader-error"><text>{{commentsError}}</text><button class="reader-retry" bindtap="retryComments">重新加载评论</button></view>
      <view wx:for="{{comments}}" wx:key="id" class="reader-comment"><image wx:if="{{item.author.avatarUrl}}" class="comment-face" src="{{item.author.avatarUrl}}" mode="aspectFill" lazy-load="true" /><view wx:else class="comment-face comment-face-fallback">{{item.author.displayName ? item.author.displayName[0] : '悦'}}</view><view class="comment-main"><view class="comment-heading"><view><view class="comment-person">{{item.author.displayName}}</view><view class="comment-time">{{item.dateText}}</view></view><button wx:if="{{item.canDelete}}" class="comment-delete" data-id="{{item.id}}" bindtap="deleteComment" disabled="{{commentBusy || !!reactionBusy}}" aria-label="删除 {{item.author.displayName}} 的评论">删除</button></view><view class="comment-text" selectable="true">{{item.content}}</view></view></view>
      <view wx:if="{{commentsLoading}}" class="reader-state">正在读取回应…</view><button wx:elif="{{commentsMore}}" class="reader-comments-more" bindtap="moreComments" hover-class="reader-pressed">查看更多回应 ↓</button><view wx:elif="{{!comments.length && !commentsError}}" class="reader-no-comments">{{post.commentsEnabled ? '还没有回应，第一句想法也许来自你。' : '还没有公开回应。'}}</view>
    </view>
    <view class="reader-signature">Brclio · Stay curious. Keep building.</view>

    <view wx:if="{{post.status === 'published'}}" class="reader-dock">
      <button class="dock-compose" bindtap="focusComments" hover-class="reader-pressed" aria-label="{{post.commentsEnabled ? '前往评论区写评论' : '查看已有评论'}}"><view class="dock-comment-icon" aria-hidden="true"></view><text>{{post.commentsEnabled ? '写下你的想法…' : '查看回应'}}</text><text wx:if="{{post.counts.comments}}" class="dock-comment-count">{{post.counts.comments}}</text></button>
      <button class="dock-action" open-type="share" hover-class="reader-pressed" aria-label="分享这篇文章"><text class="dock-symbol dock-share">↗</text><text class="dock-label">分享</text></button>
      <button class="dock-action {{interaction.favorited ? 'dock-favorite-active' : ''}}" data-type="favorite" bindtap="react" disabled="{{!!reactionBusy || commentBusy}}" hover-class="reader-pressed" aria-label="{{interaction.favorited ? '取消收藏' : '收藏文章'}}，{{post.counts.favorites}} 次收藏"><text class="dock-symbol">{{interaction.favorited ? '★' : '☆'}}</text><text class="dock-label">{{post.counts.favorites}}</text></button>
      <button class="dock-action {{interaction.liked ? 'dock-like-active' : ''}}" data-type="like" bindtap="react" disabled="{{!!reactionBusy || commentBusy}}" hover-class="reader-pressed" aria-label="{{interaction.liked ? '取消点赞' : '点赞文章'}}，{{post.counts.likes}} 次点赞"><text class="dock-symbol dock-heart">{{interaction.liked ? '♥' : '♡'}}</text><text class="dock-label">{{post.counts.likes}}</text></button>
    </view>
  </block>
</view>
