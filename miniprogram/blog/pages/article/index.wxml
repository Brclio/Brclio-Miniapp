<view class="page-shell article-shell">
  <view class="article-nav"><button class="text-button" bindtap="openList">← 博客列表</button><button class="text-button" bindtap="copyLink">复制网页链接 ↗</button></view>
  <view wx:if="{{loading && !post}}" class="state-message" aria-live="polite">正在打开文章…</view>
  <view wx:if="{{error}}" class="state-message error-message" role="alert"><text>{{error}}</text><button class="secondary-button" bindtap="reload">重新加载</button></view>
  <block wx:if="{{post}}">
    <view class="article-header"><view class="article-category">{{post.category || '随笔'}} <text wx:if="{{post.status !== 'published'}}" class="draft-label">草稿 · 仅管理员可见</text></view><view class="article-title serif" selectable="true">{{post.title}}</view><view class="article-author"><image wx:if="{{post.author.avatarUrl}}" src="{{post.author.avatarUrl}}" class="author-avatar" mode="aspectFill" /><view><view>{{post.author.displayName}}</view><view class="article-date">{{post.dateText}} · {{post.readingMinutes}} 分钟阅读 · {{post.counts.views}} 阅读</view></view></view><view wx:if="{{post.excerpt}}" class="article-excerpt">{{post.excerpt}}</view><view wx:if="{{post.tags.length}}" class="article-tags"><text wx:for="{{post.tags}}" wx:key="*this"># {{item}}</text></view></view>
    <image wx:if="{{post.coverUrl}}" class="article-cover" src="{{post.coverUrl}}" mode="widthFix" />
    <view class="article-content"><rich-text wx:for="{{htmlChunks}}" wx:key="key" nodes="{{item.html}}" user-select="true" space="nbsp" /></view>
    <view wx:if="{{contentLoading}}" class="state-message" aria-live="polite">正在排版正文…</view>
    <view class="reading-end"><text>· · ·</text><view>感谢阅读，保持好奇。</view></view>
    <view wx:if="{{post.status === 'published'}}" class="article-actions"><button class="reaction {{interaction.liked ? 'reaction-active' : ''}}" data-type="like" bindtap="react" disabled="{{!!reactionBusy}}" hover-class="button-pressed" aria-label="{{interaction.liked ? '取消点赞' : '点赞文章'}}">{{interaction.liked ? '已赞' : '点赞'}} <text>{{post.counts.likes}}</text></button><button class="reaction {{interaction.favorited ? 'favorite-active' : ''}}" data-type="favorite" bindtap="react" disabled="{{!!reactionBusy}}" hover-class="button-pressed" aria-label="{{interaction.favorited ? '取消收藏' : '收藏文章'}}">{{interaction.favorited ? '已收藏' : '收藏'}} <text>{{post.counts.favorites}}</text></button><button class="share-button" open-type="share" hover-class="button-pressed">分享 ↗</button></view>
    <view wx:if="{{actionError}}" class="action-error" role="alert">{{actionError}}</view>
    <button wx:if="{{canEdit}}" class="admin-link" bindtap="copyWritingUrl">复制网页编辑地址 ↗</button>
    <view class="comments-section"><view class="comments-title serif">聊一聊 <text>{{post.counts.comments}}</text></view><view class="comments-intro">让交流保持友善，评论会公开显示你的昵称和头像。</view>
      <view wx:if="{{post.commentsEnabled && post.status === 'published'}}" class="comment-compose"><textarea class="comment-input" value="{{commentText}}" bindinput="inputComment" maxlength="1000" placeholder="读完之后，你想说…" aria-label="写评论，最多 1000 字" auto-height="true" /><view class="compose-bottom"><text>{{commentText.length}} / 1000</text><button class="comment-submit" bindtap="submitComment" loading="{{commentBusy}}" disabled="{{commentBusy}}">{{user ? '发布评论' : '登录后评论'}}</button></view></view>
      <view wx:elif="{{post.status === 'published'}}" class="comments-closed">这篇文章已关闭新评论，已有讨论仍可阅读。</view>
      <view wx:if="{{commentsError}}" class="state-message error-message"><text>{{commentsError}}</text><button class="secondary-button" bindtap="retryComments">重新加载评论</button></view>
      <view wx:for="{{comments}}" wx:key="id" class="comment"><image wx:if="{{item.author.avatarUrl}}" class="comment-avatar" src="{{item.author.avatarUrl}}" mode="aspectFill" lazy-load="true" /><view wx:else class="comment-avatar comment-initial">{{item.author.displayName ? item.author.displayName[0] : '悦'}}</view><view class="comment-body"><view class="comment-byline"><text class="comment-author">{{item.author.displayName}}</text><text class="comment-date">{{item.dateText}}</text></view><view class="comment-content" selectable="true">{{item.content}}</view><button wx:if="{{item.canDelete}}" class="delete-comment" data-id="{{item.id}}" bindtap="deleteComment" disabled="{{commentBusy}}" aria-label="删除 {{item.author.displayName}} 的评论">删除</button></view></view>
      <view wx:if="{{commentsLoading}}" class="state-message">正在读取讨论…</view><button wx:elif="{{commentsMore}}" class="secondary-button" bindtap="moreComments">查看更多评论</button><view wx:elif="{{!comments.length && !commentsError}}" class="no-comments">{{post.commentsEnabled ? '第一句想法，就从你开始。' : '还没有公开评论。'}}</view>
    </view>
    <view class="blog-signature">Brclio · Stay curious. Keep building.</view>
  </block>
</view>
