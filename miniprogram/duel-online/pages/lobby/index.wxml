<view class="online-page">
  <view class="online-toolbar">
    <view class="connection-state"><text class="connection-dot {{connection === 'online' && syncReady ? 'connected' : ''}}"></text><text>{{connectionLabel}}</text><text wx:if="{{connection === 'online' && syncReady}}" class="latency">{{rtt}} ms</text></view>
    <button class="sound-control" bindtap="toggleSound" hover-class="control-pressed" aria-label="{{soundEnabled ? '关闭声音' : '开启声音'}}"><image src="/pages/duel/icons/{{soundEnabled ? 'volume-2' : 'volume-x'}}.png"/></button>
  </view>

  <view wx:if="{{error}}" class="message error-message" role="alert">{{error}}</view>
  <view wx:if="{{friendError && (activeList !== 'friends' || room)}}" class="message error-message" role="alert">{{friendError}}</view>
  <view wx:if="{{notice}}" class="message notice-message">{{notice}}</view>
  <view wx:if="{{connection === 'online' && !syncReady && !activeRound}}" class="calibration-note"><text>正在校准时间，网络稳定后即可准备。</text><button class="calibrate-action" bindtap="calibrate" disabled="{{working}}" hover-class="control-pressed">重新校准</button></view>

  <block wx:if="{{connection === 'login'}}">
    <view class="welcome"><text class="eyebrow">TWO PHONES, ONE CHALLENGE</text><view class="page-heading serif">两部手机，一起 PK。</view><text class="intro-copy">登录后，邀请另一位在线玩家。你们各用自己的手机，只点自己的按钮。</text><view wx:if="{{pendingEntryCode}}" class="entry-invitation"><text>好友的邀请已保留</text><text class="entry-code">{{pendingEntryCode}}</text><text>登录返回后自动加入。</text></view><view class="versus-art" aria-hidden="true"><text class="art-red">红</text><text class="art-versus serif">vs.</text><text class="art-blue">蓝</text></view><button class="primary-action" bindtap="login" hover-class="control-pressed">{{pendingEntryCode ? '登录并加入好友 PK' : '登录后开始'}}</button><button class="plain-action" bindtap="back" hover-class="control-pressed">返回同屏双人玩法</button></view>
  </block>

  <block wx:elif="{{room}}">
    <view class="room-heading"><view><text class="eyebrow">ONLINE DUEL</text><view class="page-heading serif">各自出手，同时开局。</view></view><button class="leave-action" bindtap="leave" disabled="{{working}}" hover-class="control-pressed">离开本局</button></view>
    <view class="players-strip"><view wx:for="{{players}}" wx:key="id" class="room-player player-{{item.color}}"><view class="player-identity"><image wx:if="{{item.avatarUrl}}" class="player-avatar" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:else class="player-avatar avatar-fallback">{{item.initial}}</view><view class="player-detail"><text class="player-name">{{item.label}}<text wx:if="{{item.mine}}" class="me-label">（我）</text></text><text class="player-meta">{{item.colorLabel}} · {{roomFinished ? item.reactionLabel : item.ready ? '已准备' : '未准备'}}</text></view></view></view></view>

    <block wx:if="{{roomFinished}}">
      <view class="result-panel"><text class="eyebrow">{{room.phase === 'aborted' ? 'ROUND STOPPED' : 'THIS ROUND'}}</text><view class="result-heading serif">{{resultTitle || phaseTitle}}</view><text class="result-copy">{{resultCopy || phaseCopy}}</text></view>
      <block wx:for="{{players}}" wx:key="id"><view wx:if="{{!item.mine}}" class="keep-friend-row"><text>下次还和 {{item.label}} 玩？</text><button class="friend-action" data-id="{{item.id}}" bindtap="addFriend" disabled="{{working || friendsLoading || item.friendStatus === 'friend' || item.friendStatus === 'outgoing'}}" hover-class="control-pressed">{{item.friendStatus === 'friend' ? '已是好友' : item.friendStatus === 'outgoing' ? '已申请' : item.friendStatus === 'incoming' ? '接受申请' : '加为好友'}}</button></view></block>
      <view class="room-actions"><button wx:if="{{room.phase === 'result'}}" class="primary-action" bindtap="ready" disabled="{{working || myReady || !syncReady}}" hover-class="control-pressed">{{myReady ? '已准备，等待对方' : !syncReady ? '校准时间中…' : '准备再来一局'}}</button><button class="secondary-action" bindtap="leave" disabled="{{working}}" hover-class="control-pressed">返回在线大厅</button></view>
    </block>
    <block wx:else>
      <view class="round-signal {{room.phase === 'go' ? 'signal-go' : ''}}"><view class="signal-title serif">{{tapped ? '已出手' : phaseTitle}}</view><text class="signal-copy">{{tapped ? '等待双方结果，请稍候。' : phaseCopy}}</text></view>
      <view class="own-button own-{{myColor}} {{canTap ? 'target-active' : ''}} {{room.phase === 'go' ? 'target-go' : ''}}" bindtouchstart="tap" aria-role="button" aria-disabled="{{!canTap}}" aria-label="{{myColor === 'red' ? '我的红方按钮' : '我的蓝方按钮'}}"><text class="target-color">{{myColor === 'red' ? 'RED / 我是红方' : 'BLUE / 我是蓝方'}}</text><image class="target-icon" src="/pages/duel/icons/hand-{{myColor === 'red' ? 'rose' : 'sky'}}.png"/><text class="target-word serif">{{tapped ? '已出手' : room.phase === 'go' ? '点这里！' : room.phase === 'waiting' ? '等 GO 再点' : '我的按钮'}}</text><text class="target-hint">{{room.phase === 'waiting' ? '现在点会抢跑' : room.phase === 'go' ? '越快越好' : '对方的按钮在 TA 自己的手机上'}}</text></view>
      <view class="room-actions"><button wx:if="{{room.phase === 'ready'}}" class="primary-action" bindtap="ready" disabled="{{working || myReady || !syncReady}}" hover-class="control-pressed">{{myReady ? '已准备，等待对方' : !syncReady ? '校准时间中…' : '我准备好了'}}</button><view wx:else class="foreground-hint">请保持小程序在前台，离开会中止本局。</view></view>
    </block>
    <view class="room-footnote">按统一时间播放信号 · 以本机反应时间判定</view>
  </block>

  <block wx:else>
    <view class="lobby-heading"><text class="eyebrow">MEET IN THE LOBBY</text><view class="page-heading serif">选一位对手，来一局。</view><text class="intro-copy">两个人都进入这里，就能互相邀请。红蓝随机分配，双方准备后同步发出 GO 信号。</text></view>
    <view wx:if="{{user}}" class="self-row"><image wx:if="{{user.avatarUrl}}" class="player-avatar" src="{{user.avatarUrl}}" mode="aspectFill"/><view wx:else class="player-avatar avatar-fallback">{{userInitial}}</view><view class="self-detail"><text class="player-name">{{userLabel}}</text><text class="self-caption">{{user.username ? '我的账号：' + user.username : '你在大厅中，其他玩家可以邀请你'}}</text></view></view>

    <view class="code-section">
      <view class="section-heading"><view><text class="eyebrow">SEND AN INVITATION</text><view class="section-title serif">约朋友，分享这一局。</view></view><button wx:if="{{!shareInvite}}" class="compact-action" bindtap="createCode" disabled="{{working || !canCreateCode}}" hover-class="control-pressed">创建邀请</button></view>
      <view wx:if="{{shareInvite}}" class="share-invitation"><view class="share-code-row"><text class="share-code" selectable="{{true}}">{{shareInvite.code}}</text><button class="copy-code" bindtap="copyCode" hover-class="control-pressed">复制邀请码</button></view><text class="share-status">{{shareIsOwner ? shareInvite.guest ? sharePeerName + ' 已加入，正在连接' : '等一位朋友加入，你可以直接分享给 TA。' : shareInvite.ownerOnline ? '已加入 ' + sharePeerName + ' 的邀请，正在连接。' : '已加入，等 ' + sharePeerName + ' 回到小程序。'}}<text wx:if="{{shareCountdown}}" class="share-expiry"> · {{shareCountdown}} 后过期</text></text><view class="share-actions"><button wx:if="{{shareIsOwner && shareInvite.status === 'waiting'}}" class="primary-action" open-type="share" hover-class="control-pressed">分享给微信好友</button><button class="secondary-action" bindtap="cancelCode" disabled="{{working}}" hover-class="control-pressed">{{shareIsOwner ? '取消邀请' : '离开等待'}}</button></view><text class="share-note">分享期间邀请会保留；发出后请返回小程序等待好友。</text></view>
      <text wx:elif="{{!invitation}}" class="section-copy">创建 10 分钟有效的邀请，朋友点开分享卡片即可加入。</text>
      <view wx:if="{{!shareInvite}}" class="join-code-row"><input class="code-input" value="{{inviteCodeInput}}" bindinput="codeInput" maxlength="12" placeholder="输入 8 位邀请码" confirm-type="done" bindconfirm="joinCode" aria-label="输入好友的8位邀请码"/><button class="join-code-action" bindtap="joinCode" disabled="{{working || !syncReady || invitation || connection !== 'online'}}" hover-class="control-pressed">加入 PK</button></view>
      <text wx:if="{{pendingEntryCode}}" class="pending-code-note">{{shareInvite || invitation ? '请先结束当前邀请，再加入 ' + pendingEntryCode + '。' : '正在连接好友的邀请 ' + pendingEntryCode + '，校准完成后自动加入。'}}</text>
    </view>

    <view wx:if="{{invitation}}" class="invitation-panel"><text class="eyebrow">{{invitation.direction === 'incoming' ? 'YOUR CHALLENGER' : 'INVITATION SENT'}}</text><view class="invitation-title serif">{{invitation.direction === 'incoming' ? invitationName + ' 邀请你 PK' : '等待 ' + invitationName + ' 接受'}}</view><text class="invitation-copy">{{invitation.direction === 'incoming' ? '接受后随机分配红蓝，双方准备再开局。' : '对方接受前，你可以随时取消邀请。'}}<text wx:if="{{remainingSeconds > 0}}"> · {{remainingSeconds}} 秒</text></text><view class="invitation-actions"><block wx:if="{{invitation.direction === 'incoming'}}"><button class="secondary-action" bindtap="decline" disabled="{{working}}" hover-class="control-pressed">暂不接受</button><button class="primary-action" bindtap="accept" disabled="{{working || !syncReady}}" hover-class="control-pressed">接受挑战</button></block><button wx:else class="secondary-action" bindtap="cancel" disabled="{{working}}" hover-class="control-pressed">取消邀请</button></view></view>

    <view class="list-tabs"><button class="list-tab {{activeList === 'online' ? 'tab-selected' : ''}}" data-list="online" bindtap="selectList" hover-class="control-pressed">在线玩家 <text>{{onlineCount}}</text></button><button class="list-tab {{activeList === 'friends' ? 'tab-selected' : ''}}" data-list="friends" bindtap="selectList" hover-class="control-pressed">我的好友 <text>{{friendCount}}</text><text wx:if="{{incomingCount}}" class="request-badge">{{incomingCount}}</text></button></view>
    <block wx:if="{{activeList === 'online'}}">
    <view wx:if="{{connection === 'online' && !users.length}}" class="empty-state"><view class="empty-number serif">01 / 02</view><text class="empty-title">还差一位对手。</text><text class="empty-copy">让朋友也登录并进入「在线 PK」。TA 出现后，就可以发出挑战。</text></view>
    <view wx:elif="{{connection === 'error' || connection === 'idle'}}" class="empty-state"><text class="empty-title">{{connection === 'idle' ? '重新进入在线大厅' : '暂时没有连上大厅。'}}</text><text class="empty-copy">{{connection === 'idle' ? '确认当前账号后重新连接，好友就能看到你。' : '检查网络后重试，同屏双人玩法仍可使用。'}}</text><button class="primary-action" bindtap="retry" disabled="{{working}}" hover-class="control-pressed">重新连接</button></view>
    <view wx:elif="{{connection === 'connecting' || connection === 'syncing'}}" class="empty-state"><text class="empty-title">{{connectionLabel}}…</text><text class="empty-copy">连接完成后，在线玩家会自动出现在这里。</text></view>
    <view wx:for="{{users}}" wx:key="id" class="online-user"><image wx:if="{{item.avatarUrl}}" class="player-avatar" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:else class="player-avatar avatar-fallback">{{item.initial}}</view><view class="user-detail"><text class="player-name">{{item.label}}</text><text class="player-status">{{item.busy ? '正在对战或等待邀请' : '在线 · 可以挑战'}}</text></view><view class="user-actions"><button class="invite-action" data-id="{{item.id}}" bindtap="invite" disabled="{{working || item.busy || invitation || shareInvite || !syncReady || connection !== 'online'}}" hover-class="control-pressed">{{item.busy ? '忙碌中' : '邀请 PK'}}</button><button class="friend-action" data-id="{{item.id}}" bindtap="addFriend" disabled="{{working || friendsLoading || item.friendStatus === 'friend' || item.friendStatus === 'outgoing'}}" hover-class="control-pressed">{{item.friendStatus === 'friend' ? '已是好友' : item.friendStatus === 'outgoing' ? '已申请' : item.friendStatus === 'incoming' ? '接受申请' : '加好友'}}</button></view></view>
    </block>
    <block wx:else>
      <view class="friends-tools"><text>好友关系双方确认后保留，下次直接选。</text><button class="refresh-friends" bindtap="refreshFriends" disabled="{{working || friendsLoading}}" hover-class="control-pressed">{{friendsLoading ? '读取中…' : '刷新'}}</button></view>
      <view wx:if="{{friendError}}" class="message error-message">{{friendError}}</view>
      <view class="friend-search"><input class="username-input" value="{{friendUsername}}" bindinput="usernameInput" maxlength="24" placeholder="好友的完整账号（不是邮箱）" confirm-type="done" bindconfirm="addByUsername" aria-label="输入好友的完整账号"/><button class="compact-action" bindtap="addByUsername" disabled="{{working || friendsLoading || !user}}" hover-class="control-pressed">添加</button></view>
      <view wx:if="{{friendRequests.incoming.length}}" class="friend-request-section"><view class="small-heading">收到的好友申请</view><view wx:for="{{friendRequests.incoming}}" wx:key="id" class="friend-request-row"><view class="user-detail"><text class="player-name">{{item.from.label}}</text><text class="player-status">希望和你成为 PK 好友</text></view><view class="request-actions"><button class="decline-friend" data-id="{{item.id}}" data-accept="{{false}}" bindtap="respondFriend" disabled="{{working || friendsLoading}}" hover-class="control-pressed">拒绝</button><button class="accept-friend" data-id="{{item.id}}" data-accept="{{true}}" bindtap="respondFriend" disabled="{{working || friendsLoading}}" hover-class="control-pressed">接受</button></view></view></view>
      <view wx:if="{{!friends.length && !friendsLoading}}" class="friend-empty">还没有好友。可以输入账号，或从在线玩家和对局结果中添加。</view>
      <view wx:for="{{friends}}" wx:key="id" class="online-user"><image wx:if="{{item.avatarUrl}}" class="player-avatar" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:else class="player-avatar avatar-fallback">{{item.initial}}</view><view class="user-detail"><text class="player-name">{{item.label}}</text><text class="player-status">{{!item.online ? '尚未进入在线大厅' : item.busy ? '在线 · 忙碌中' : '在线 · 可以挑战'}}</text></view><view class="user-actions"><button class="invite-action" data-id="{{item.id}}" bindtap="invite" disabled="{{working || !item.online || item.busy || invitation || shareInvite || !syncReady || connection !== 'online'}}" hover-class="control-pressed">{{!item.online ? '未在线' : item.busy ? '忙碌中' : '邀请 PK'}}</button><button class="remove-friend" data-id="{{item.id}}" bindtap="removeFriend" disabled="{{working || friendsLoading}}" hover-class="control-pressed">移除好友</button></view></view>
      <view wx:if="{{friendRequests.outgoing.length}}" class="friend-request-section"><view class="small-heading">等待对方确认</view><view wx:for="{{friendRequests.outgoing}}" wx:key="id" class="outgoing-friend"><text class="player-name">{{item.to.label}}</text><text class="player-status">申请已发送</text></view></view>
    </block>
    <view class="lobby-note"><text>只有进入在线大厅的玩家会出现在列表中。离开页面后下线，对战中离开会中止本局。</text><button class="plain-action sound-test" bindtap="testSound" disabled="{{!soundEnabled}}" hover-class="control-pressed">试听提示音 ♫</button></view>
  </block>
</view>
